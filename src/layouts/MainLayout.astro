---
// Importing necessary components
import Meta from '@components/Meta.astro';
import Analytics from '@components/Analytics.astro';
import AnalyticsNoScript from '@components/AnalyticsNoScript.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import QuoteCart from '@components/QuoteCart.astro';
import ChatWidget from '@components/ChatWidget.astro';
import { SITE } from '@data/constants';
import type { EventoDePagina } from '@utils/analytics';
import '@styles/global.css';

// Setting expected props
const {
  title = SITE.title,
  meta,
  structuredData,
  lang = 'es',
  customDescription = null,
  customOgTitle = null,
  hideFooter = false,
  heroASangre = false,
  analytics,
} = Astro.props;

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
  hideFooter?: boolean;
  /**
   * La página empieza con un bloque que debe llegar hasta el borde superior de
   * la pantalla, por debajo de la barra de navegación (hoy: el hero de la
   * portada). Quita el relleno que separa el contenido de la barra; el bloque
   * se encarga él mismo de que su contenido no quede tapado.
   */
  heroASangre?: boolean;
  /**
   * El evento de medición que dispara la página por el hecho de abrirse: la
   * ficha de una referencia, el catálogo, la página de una categoría. Las
   * páginas que no lo declaran solo cuentan la visita. Ver `@utils/analytics`.
   */
  analytics?: EventoDePagina;
}
---

{
  /*
    `scroll-pt-24` es el colchón que deja un salto a un ancla para no aterrizar
    debajo de la barra de navegación, que va flotando y tapa lo que quede
    detrás.

    Eran 16 (64 px) y no daba: la píldora mide unos 59 px de alto y baja 16
    desde el borde, así que su canto inferior queda sobre los 75 y el destino
    del salto caía justo debajo. 96 px lo despeja con margen.

    Hoy no se nota, y conviene decirlo: el único ancla del sitio es el enlace
    de "Ir al contenido", que apunta al principio del documento, donde no hay
    hacia dónde desplazarse y ningún colchón puede aplicarse. Esto está por lo
    que venga —una sección con `#id`, un índice de preguntas frecuentes— para
    que el valor correcto ya esté puesto cuando haga falta.
  */
}<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-24">
  <head>
    {/* Adding metadata to the HTML document */}
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
    />
    {/* Píxel de Meta y etiqueta de Google. Cuanto más arriba, mejor mide. */}
    <Analytics evento={analytics} />
    {/* Define the title of the page */}
    <title>{title}</title>
    <script is:inline>
      // Script to handle dark mode. El tema claro es el predeterminado: solo se
      // aplica el modo oscuro si el visitante lo eligió explícitamente, o si
      // guardó 'auto' y su sistema prefiere el esquema oscuro.
      const storedTheme = localStorage.getItem('hs_theme');
      if (
        storedTheme === 'dark' ||
        (storedTheme === 'auto' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script>
      import '@scripts/lenisSmoothScroll.js';
      import '@scripts/contactForms.js';
      import '@scripts/quoteCart.js';
    </script>
  </head>
  <body
    class="selection:bg-brand-400 flex min-h-screen flex-col bg-neutral-200 selection:text-neutral-700 dark:bg-neutral-800"
  >
    <AnalyticsNoScript />
    <a
      href="#main-content"
      class="focus:bg-brand-400 sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:px-4 focus:py-2 focus:text-neutral-800"
    >
      Ir al contenido
    </a>
    {
      /*
      Estructura de la página: navbar arriba, el contenido en el slot y el
      footer al final.

      El contenido va a sangre: no hay caja que lo limite, así que las fotos y
      los fondos de sección llegan hasta el borde de la pantalla en vez de
      cortarse contra un ancho máximo. La lectura no se mueve por eso — cada
      sección sigue centrando su texto con `mx-auto max-w-[85rem]`. La barra
      de navegación sí va contenida, porque es una píldora flotante que debe
      quedar separada de los bordes (ver Navbar.astro).
      */
    }
    <Navbar />
    {
      /*
        La barra va `fixed` y no ocupa sitio en el flujo, así que el contenido
        empieza pegado al borde superior. Estas páginas recuperan ese espacio
        con un relleno equivalente al alto de la barra más su separación del
        borde (unos 76 px); las que traen un hero a sangre lo dejan pasar por
        debajo a propósito.
      */
    }
    <main
      id="main-content"
      class:list={['w-full grow', !heroASangre && 'pt-[4.75rem]']}
    >
      <slot />
    </main>
    {!hideFooter && <FooterSection />}
    <QuoteCart />
    <ChatWidget />
    <script>
      // https://preline.co
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
