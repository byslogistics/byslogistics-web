---
import { GOOGLE, OPINIONES, type Opinion } from '@data/opiniones';

/**
 * Las opiniones reales de Google, en movimiento.
 *
 * QUÉ SUSTITUYE. A los «Testimonios de nuestros clientes», que era un
 * blockquote quieto con una frase suelta: no se sabía de dónde salía, no se
 * podía comprobar y no se movía. Aquí cada tarjeta es una reseña publicada en
 * la ficha de Google de la empresa y ENLAZA A ELLA, así que la autenticidad no
 * hay que afirmarla —se comprueba—. Es lo único que distingue una opinión de
 * un eslogan.
 *
 * ABRE EN UNA PESTAÑA NUEVA, y es a propósito: quien va a verificar una reseña
 * está a mitad de decidir. Sacarlo del sitio para que vuelva con el botón
 * «atrás» es perder la visita justo ahí.
 *
 * DOS FORMAS, SEGÚN CUÁNTAS HAYA
 *
 *   · **Tres o más**: una cinta que se desplaza sola, en dos filas que corren
 *     en sentidos opuestos. Es lo que hace que la sección se lea como algo
 *     vivo en lugar de como una tabla de citas. La lista se imprime DOS VECES
 *     dentro de cada fila: es lo que permite que el bucle vuelva al principio
 *     sin salto, porque cuando la primera copia sale por la izquierda la
 *     segunda está exactamente donde estaba la primera.
 *   · **Menos de tres**: quietas y centradas. Una cinta con dos tarjetas
 *     repetidas no parece un muro de reseñas, parece la misma reseña copiada,
 *     que es peor que no tener cinta.
 *
 * SE PARA CON EL PUNTERO ENCIMA Y CON EL FOCO DENTRO, y no se mueve con
 * `prefers-reduced-motion`. Una reseña hay que poder leerla: si el texto se
 * escapa mientras se lee, la sección estorba en lugar de convencer. La pausa
 * es solo CSS —`animation-play-state`—, sin una línea de JavaScript.
 */
interface Props {
  title: string;
  subTitle?: string;
  opiniones?: Opinion[];
}

const { title, subTitle, opiniones = OPINIONES } = Astro.props;

/** A partir de tres tarjetas la cinta se lee como un muro; con menos, no. */
const enMovimiento = opiniones.length >= 3;

/*
 * Dos filas que corren en sentidos contrarios. El reparto es por posición
 * —pares arriba, impares abajo— y no aleatorio, para que el HTML de la página
 * sea el mismo en cada compilación.
 */
const filas = enMovimiento
  ? [
      opiniones.filter((_, i) => i % 2 === 0),
      opiniones.filter((_, i) => i % 2 === 1),
    ]
  : [opiniones];

/**
 * CUÁNTAS VECES SE IMPRIME CADA FILA.
 *
 * El bucle sin salto se consigue imprimiendo la fila dos veces y desplazando
 * el tren justo la mitad de su ancho: al llegar ahí, la segunda copia está
 * exactamente donde arrancó la primera. Pero eso solo funciona si CADA MITAD
 * es más ancha que la pantalla; si no, al desplazarse aparece un hueco por el
 * lado por el que la fila se está yendo. Con tres reseñas y un monitor ancho
 * es justo lo que pasaba.
 *
 * Así que cada mitad se rellena repitiendo la fila hasta juntar al menos ocho
 * tarjetas —unos tres mil píxeles, más que cualquier pantalla razonable— y el
 * número total de copias se mantiene PAR, que es lo que el desplazamiento del
 * 50 % da por supuesto.
 */
const MINIMO_POR_MITAD = 8;
const copiasDe = (cantidad: number) =>
  2 * Math.max(1, Math.ceil(MINIMO_POR_MITAD / cantidad));

/** La vuelta dura en proporción a lo que mide el tren: con la misma duración,
 *  un tren largo pasaría volando y uno corto se arrastraría. */
const duracion = (tarjetas: number) => `${Math.max(30, tarjetas * 5.5)}s`;

const estrellasDe = (cuantas: number) =>
  Array.from({ length: 5 }, (_, i) => i < cuantas);

const puntuacion = GOOGLE.puntuacion.toLocaleString('es-CO', {
  minimumFractionDigits: 1,
});
---

<section class="opiniones relative overflow-hidden">
  <div class="mx-auto max-w-[85rem] px-10 pt-16 sm:px-14 lg:px-20 lg:pt-24">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-12">
      <div class="max-w-2xl" data-anim-cascada="izquierda">
        <h2
          class="mb-3 text-3xl font-bold text-balance text-neutral-800 lg:text-5xl dark:text-neutral-100"
        >
          {title}
        </h2>
        {
          subTitle && (
            <p class="max-w-prose text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400">
              {subTitle}
            </p>
          )
        }
      </div>

      {
        /* La nota media, en grande. Es el dato que se mira antes de leer
          ninguna reseña, y el que decide si se leen. */
      }
      <div
        class="mt-8 flex shrink-0 items-center gap-x-5 rounded-2xl border border-neutral-300 bg-neutral-100/80 p-5 lg:mt-0 dark:border-neutral-700 dark:bg-neutral-900/70"
        data-anim="derecha"
      >
        <div class="text-center">
          <p
            class="text-4xl font-bold text-neutral-800 tabular-nums dark:text-neutral-100"
          >
            {puntuacion}
          </p>
          {
            /* `role="img"` no es opcional: un `aria-label` sobre un `<div>` a
              secas está prohibido por la especificación —un contenedor genérico
              no admite nombre accesible— y axe lo marca como violación. Con el
              rol, las cinco estrellas pasan a ser UNA imagen que se llama
              «5,0 de 5 estrellas», que es justo lo que son. */
          }
          <div
            class="mt-1 flex justify-center gap-x-0.5"
            role="img"
            aria-label={`${puntuacion} de 5 estrellas`}
          >
            {
              estrellasDe(Math.round(GOOGLE.puntuacion)).map(llena => (
                <span
                  class:list={['estrella', llena && 'is-llena']}
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5L2.6 9.3l6.5-.9L12 2.5Z" />
                  </svg>
                </span>
              ))
            }
          </div>
        </div>

        <div>
          <p class="font-bold text-neutral-800 dark:text-neutral-200">
            {
              GOOGLE.total
                ? `${GOOGLE.total} reseñas en Google`
                : 'Opiniones en Google'
            }
          </p>
          <a
            href={GOOGLE.ficha}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-700 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 mt-1 inline-flex items-center gap-x-1.5 text-sm font-bold underline underline-offset-4 outline-hidden focus-visible:ring-3"
          >
            Verlas en Google
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path>
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
            </svg>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  {
    /* La cinta va FUERA de la caja de lectura, a sangre: cortada contra un
      ancho máximo dejaría de leerse como algo que sigue más allá del borde,
      que es de donde sale la sensación de que hay muchas más. */
  }
  <div
    class:list={['opiniones-cinta mt-10 lg:mt-14', enMovimiento && 'is-viva']}
    data-anim
    data-anim-retraso="2"
  >
    {
      filas.map((fila, indice) => (
        <div
          class="opiniones-pista"
          style={`--vuelta:${duracion(fila.length * copiasDe(fila.length))}`}
        >
          <ul
            class:list={['opiniones-tren', indice % 2 === 1 && 'va-al-reves']}
          >
            {/* Varias pasadas de la misma lista: es lo que cierra el bucle
                sin salto (ver `copiasDe`). Solo la PRIMERA cuenta como
                contenido; las demás son copias visuales, así que se esconden
                del lector de pantalla y del tabulador en lugar de repetir la
                misma reseña media docena de veces. */}
            {Array.from({ length: copiasDe(fila.length) }, (_, copia) =>
              fila.map(opinion => (
                <li
                  class="opiniones-tarjeta"
                  aria-hidden={copia === 0 ? undefined : 'true'}
                >
                  <a
                    href={GOOGLE.ficha}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="opiniones-enlace"
                    tabindex={copia === 0 ? undefined : -1}
                  >
                    <div class="opiniones-cabecera">
                      <span class="opiniones-avatar" aria-hidden="true">
                        {opinion.autor.trim().charAt(0)}
                      </span>
                      <div class="min-w-0">
                        <p class="opiniones-autor">{opinion.autor}</p>
                        <div class="mt-0.5 flex items-center gap-x-2">
                          {/* El nombre va en el grupo de estrellas y no en el
                              renglón entero: al lado vive la fecha, y con el
                              `aria-label` fuera se perdería. Ver la nota del
                              bloque de la nota media. */}
                          <span
                            class="flex gap-x-0.5"
                            role="img"
                            aria-label={`${opinion.estrellas} de 5 estrellas`}
                          >
                            {estrellasDe(opinion.estrellas).map(llena => (
                              <span
                                class:list={['estrella', llena && 'is-llena']}
                              >
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                  <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5L2.6 9.3l6.5-.9L12 2.5Z" />
                                </svg>
                              </span>
                            ))}
                          </span>
                          {opinion.cuando && (
                            <span class="opiniones-cuando">
                              {opinion.cuando}
                            </span>
                          )}
                        </div>
                      </div>
                      {/* El isotipo de Google: es lo que dice de dónde viene
                          la reseña sin tener que escribirlo. */}
                      <span class="opiniones-google" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path
                            fill="#4285F4"
                            d="M23 12.27c0-.82-.07-1.6-.21-2.36H12v4.47h6.17a5.28 5.28 0 0 1-2.29 3.46v2.88h3.7C21.74 18.75 23 15.8 23 12.27Z"
                          />
                          <path
                            fill="#34A853"
                            d="M12 23.5c3.1 0 5.7-1.03 7.6-2.78l-3.71-2.88c-1.03.69-2.35 1.1-3.89 1.1-2.99 0-5.52-2.02-6.43-4.73H1.74v2.97A11.49 11.49 0 0 0 12 23.5Z"
                          />
                          <path
                            fill="#FBBC05"
                            d="M5.57 14.21a6.9 6.9 0 0 1 0-4.41V6.83H1.74a11.5 11.5 0 0 0 0 10.34l3.83-2.96Z"
                          />
                          <path
                            fill="#EA4335"
                            d="M12 5.07c1.69 0 3.2.58 4.4 1.72l3.28-3.28C17.7 1.63 15.1.5 12 .5 7.54.5 3.68 3.06 1.74 6.83L5.57 9.8c.91-2.71 3.44-4.73 6.43-4.73Z"
                          />
                        </svg>
                      </span>
                    </div>

                    <p class="opiniones-texto">{opinion.texto}</p>

                    <span class="opiniones-pie">
                      Ver esta reseña en Google
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <path d="M15 3h6v6" />
                        <path d="M10 14 21 3" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))
            )}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="mx-auto max-w-[85rem] px-10 pt-10 pb-16 sm:px-14 lg:px-20 lg:pb-24"
    data-anim
    data-anim-retraso="3"
  >
    <a
      href={GOOGLE.ficha}
      target="_blank"
      rel="noopener noreferrer"
      class="bg-brand-600 hover:bg-brand-700 shadow-brand-600/25 inline-flex items-center gap-x-2 rounded-full px-7 py-3.5 font-bold text-neutral-50 shadow-lg ring-zinc-500 outline-hidden transition duration-300 hover:-translate-y-0.5 focus-visible:ring-3 active:translate-y-0 dark:ring-zinc-200"
    >
      Leer todas las reseñas en Google
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
        ></path>
        <path d="M15 3h6v6"></path>
        <path d="M10 14 21 3"></path>
      </svg>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </div>
</section>

<style>
  /* ---------- ESTRELLAS ---------- */
  .estrella {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--color-neutral-300);
  }

  :global(.dark) .estrella {
    color: var(--color-neutral-700);
  }

  /* El ámbar de las estrellas de Google. No sale de la rampa de marca a
     propósito: una estrella azul no se lee como una calificación. */
  .estrella.is-llena {
    color: #f5b300;
  }

  .estrella svg {
    width: 100%;
    height: 100%;
  }

  /* ---------- LA CINTA ---------- */
  .opiniones-cinta {
    display: grid;
    gap: 1.25rem;
  }

  .opiniones-pista {
    overflow: hidden;
    /* Los bordes se desvanecen: sin esto las tarjetas aparecen y desaparecen
       de golpe contra el filo de la pantalla, y el corte delata el truco. */
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 6rem,
      #000 calc(100% - 6rem),
      transparent 100%
    );
  }

  .opiniones-tren {
    display: flex;
    width: max-content;
    gap: 1.25rem;
    padding: 0.5rem 1.25rem;
  }

  /* Sin movimiento (menos de tres reseñas) la fila se centra en lugar de
     empezar pegada al borde izquierdo, que es donde la dejaría el `max-content`
     de la cinta. */
  .opiniones-cinta:not(.is-viva) .opiniones-pista {
    mask-image: none;
    display: flex;
    justify-content: center;
  }

  .opiniones-cinta:not(.is-viva) .opiniones-tren {
    flex-wrap: wrap;
    justify-content: center;
    max-width: 85rem;
  }

  /* Las pasadas de más solo hacen falta para cerrar el bucle. Quietas, serían
     la misma reseña repetida en pantalla. */
  .opiniones-cinta:not(.is-viva) .opiniones-tarjeta[aria-hidden='true'] {
    display: none;
  }

  .opiniones-cinta.is-viva .opiniones-tren {
    animation: opiniones-correr var(--vuelta, 40s) linear infinite;
  }

  .opiniones-cinta.is-viva .opiniones-tren.va-al-reves {
    animation-direction: reverse;
  }

  /* La vuelta entera es MEDIO recorrido: la lista está impresa dos veces, así
     que al haber avanzado la mitad del ancho el tren está exactamente donde
     empezó y el salto de vuelta no se ve. */
  @keyframes opiniones-correr {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Una reseña hay que poder leerla: con el puntero encima o el foco dentro,
     la cinta se para. Solo CSS, sin un script que lo vigile. */
  .opiniones-cinta.is-viva:hover .opiniones-tren,
  .opiniones-cinta.is-viva:focus-within .opiniones-tren {
    animation-play-state: paused;
  }

  /* ---------- LA TARJETA ---------- */
  .opiniones-tarjeta {
    flex: none;
    width: min(22rem, 82vw);
  }

  .opiniones-enlace {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem;
    border: 1px solid var(--color-neutral-300);
    border-radius: 1.25rem;
    background: var(--color-neutral-100);
    box-shadow: 0 18px 40px -32px rgb(0 32 58 / 0.65);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s,
      box-shadow 0.3s;
  }

  :global(.dark) .opiniones-enlace {
    border-color: var(--color-neutral-700);
    background: var(--color-neutral-900);
  }

  .opiniones-enlace:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand-400);
    box-shadow: 0 26px 50px -30px rgb(0 32 58 / 0.55);
  }

  .opiniones-enlace:focus-visible {
    outline: 3px solid var(--color-brand-500);
    outline-offset: 3px;
  }

  .opiniones-cabecera {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .opiniones-avatar {
    display: inline-flex;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-brand-600);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
  }

  .opiniones-autor {
    font-weight: 700;
    color: var(--color-neutral-800);
  }

  :global(.dark) .opiniones-autor {
    color: var(--color-neutral-200);
  }

  .opiniones-cuando {
    font-size: 0.75rem;
    color: var(--color-neutral-500);
  }

  .opiniones-google {
    margin-left: auto;
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  .opiniones-google svg {
    width: 100%;
    height: 100%;
  }

  .opiniones-texto {
    flex: 1;
    color: var(--color-neutral-700);
    line-height: 1.6;
    text-wrap: pretty;
  }

  :global(.dark) .opiniones-texto {
    color: var(--color-neutral-300);
  }

  .opiniones-pie {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-brand-700);
  }

  :global(.dark) .opiniones-pie {
    color: var(--color-brand-400);
  }

  .opiniones-pie svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .opiniones-enlace:hover .opiniones-pie {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .opiniones-cinta.is-viva .opiniones-tren {
      animation: none;
    }

    .opiniones-enlace {
      transition: none;
    }

    .opiniones-enlace:hover {
      transform: none;
    }

    /* Sin animación la cinta no vuelve al principio, así que las pasadas de
       más se quedan a mitad de camino y sin llegar nunca: mejor no pintarlas. */
    .opiniones-cinta .opiniones-tarjeta[aria-hidden='true'] {
      display: none;
    }

    .opiniones-cinta .opiniones-pista {
      overflow-x: auto;
      mask-image: none;
    }
  }
</style>
