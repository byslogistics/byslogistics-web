---
// Import the necessary dependencies
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import SectionBackdrop from '@components/ui/blocks/SectionBackdrop.astro';
import backdropDefault from '@images/backgrounds/logistica-oscuro.jpg';
import { CONTACT } from '@data/constants';

// Define props from Astro
const {
  title,
  subTitle,
  url,
  btnTitle = 'Contáctenos',
  backdrop = backdropDefault,
} = Astro.props;

// Define TypeScript interface for props
interface Props {
  title: string;
  subTitle?: string;
  url?: string;
  btnTitle?: string;
  backdrop?: ImageMetadata;
}
---

{
  /* Cierre de página: el texto va a la izquierda y la imagen ocupa la derecha
     a plena intensidad, desvaneciéndose antes de llegar al texto. */
}
<section
  class="relative overflow-hidden border-t border-neutral-300 dark:border-neutral-700"
>
  <SectionBackdrop src={backdrop} side="right" width="55%" treatment="photo" />

  <div
    class="relative mx-auto max-w-[85rem] px-10 py-20 sm:px-14 lg:px-20 lg:py-28"
  >
    {/* Escalonado, como el cierre de la portada. Ver MainSection. */}
    <div class="max-w-2xl" data-anim-cascada="izquierda">
      {/* Hero Section Heading */}
      <h2
        class="text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-100"
      >
        {title}
      </h2>
      {/* Hero Section Sub-heading */}
      {
        subTitle && (
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-pretty text-neutral-600 lg:text-xl dark:text-neutral-400">
            {subTitle}
          </p>
        )
      }
      {/* Call to action */}
      {
        url && (
          <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
            <PrimaryCTA title={btnTitle} url={url} size="lg" />
            <SecondaryCTA
              title="Escribir por WhatsApp"
              url={CONTACT.whatsapp}
              size="lg"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
