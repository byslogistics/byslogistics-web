---
//Import relevant dependencies
import ThemeIcon from '@components/ThemeIcon.astro';
import NavLink from '@components/ui/links/NavLink.astro';
import strings from '@utils/navigation.ts';
import BrandLogo from '@components/BrandLogo.astro';
import QuoteButton from '@components/ui/buttons/QuoteButton.astro';
import QuoteCta from '@components/ui/buttons/QuoteCta.astro';
import { SITE } from '@/data_files/constants';
---

{
  /* Main header component. La píldora queda contenida y separada de los bordes;
     el resto de la página va a sangre (ver MainLayout).

     Va `fixed` y no `sticky`: así deja de ocupar sitio en el flujo y el
     contenido puede pasarle por debajo, que es lo que permite un hero a
     pantalla completa empezando en el borde superior. Antes la barra empujaba
     la página hacia abajo y quedaba una franja del fondo del cuerpo por encima
     del hero. Las páginas que no llevan hero a sangre recuperan ese espacio
     con el relleno que les pone MainLayout. */
}
<header
  data-navbar
  class="navbar fixed inset-x-0 top-4 z-50 mx-auto flex w-full max-w-(--breakpoint-2xl) items-start gap-x-2 px-4 text-sm sm:gap-x-3 sm:px-6 lg:px-8"
>
  {
    /* Navigation container.

       El vidrio —`bg-brand-50/60` con `backdrop-blur-md`, y sus pares para el
       modo oscuro— es el de siempre y no se toca desde el <style> de abajo:
       ver la nota que hay allí.

       En pantallas anchas es una rejilla de tres columnas —`1fr auto 1fr`— y no
       un `justify-between`: con columnas laterales del mismo ancho, los enlaces
       quedan centrados en la píldora de verdad, y no desplazados por lo que
       midan el logo o los botones de la derecha.

       El menú se despliega a partir de `lg` y no de `md`: con «Inicio» delante
       son ocho enlaces más el logo y dos botones, y en 768 px eso se apelmaza. */
  }
  <nav
    class="navbar-pill border-brand-100/40 bg-brand-50/60 relative w-full min-w-0 grow rounded-[36px] border px-4 py-3 backdrop-blur-md lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-x-4 lg:px-6 lg:py-0 xl:px-8 dark:border-neutral-700/40 dark:bg-neutral-800/80 dark:backdrop-blur-md"
    aria-label="Global"
  >
    <div class="flex items-center justify-between gap-x-2">
      {/* Brand logo */}
      <a
        class="navbar-logo flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden"
        href="/"
        aria-label={SITE.title}
      >
        <BrandLogo class="h-auto w-24" variante="navbar" />
      </a>
      {
        /* En móvil solo acompaña al logo el COTIZADOR, y solo cuando tiene
          algo dentro: escondido en el menú plegable quedaría fuera de la vista
          justo cuando hay una cotización que enviar.

          El CTA «Cotizar» NO está aquí, y es una decisión: sin etiqueta se
          quedaba en un círculo azul con una etiqueta de precio dentro, al lado
          del cotizador y del botón del menú —tres círculos seguidos, ninguno
          legible—, y llevaba al catálogo, que ya está en el menú a un toque.
          En pantalla ancha sí se mantiene, abajo, donde tiene sitio para su
          etiqueta. */
      }
      <div class="ml-auto flex items-center gap-x-2 lg:hidden">
        <QuoteButton />
      </div>

      {/* Collapse toggle for smaller screens */}
      <div class="lg:hidden">
        <button
          type="button"
          class="hs-collapse-toggle flex h-11 w-11 items-center justify-center rounded-full text-sm font-bold text-neutral-600 transition duration-300 hover:bg-neutral-200 disabled:pointer-events-none disabled:opacity-50 dark:text-neutral-400 dark:hover:bg-neutral-700 dark:focus:outline-hidden"
          data-hs-collapse="#navbar-collapse-with-animation"
          aria-controls="navbar-collapse-with-animation"
          aria-label="Toggle navigation"
        >
          <svg
            class="hs-collapse-open:hidden h-[1.25rem] w-[1.25rem] shrink-0"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
          <svg
            class="hs-collapse-open:block hidden h-[1.25rem] w-[1.25rem] shrink-0"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>
    {/* Contains navigation links */}
    <div
      id="navbar-collapse-with-animation"
      class="hs-collapse hidden basis-full overflow-hidden transition-all duration-300 lg:block"
    >
      {/* Navigation links container */}
      <div
        class="navbar-links mt-5 flex flex-col items-center gap-x-0 gap-y-4 lg:mt-0 lg:flex-row lg:justify-center lg:gap-x-3 lg:gap-y-0 xl:gap-x-6"
      >
        {/* Navigation links */}
        {
          strings.navBarLinks.map(link => (
            <NavLink url={link.url} name={link.name} />
          ))
        }
      </div>
    </div>

    {
      /* Extremo derecho: la cotización acumulada y el CTA que lleva al catálogo */
    }
    <div class="hidden lg:flex lg:items-center lg:justify-end lg:gap-x-2">
      <QuoteButton />
      <QuoteCta />
    </div>
  </nav>

  {
    /* El interruptor de tema vive FUERA de la píldora, en la esquina superior
       derecha de la pantalla: es un ajuste del sitio, no un destino, así que no
       compite con los enlaces ni con el CTA. Repite el vidrio de la barra para
       que se lea como parte del mismo conjunto.

       Va pequeño (36 px) y con margen derecho negativo, que le come parte del
       relleno del contenedor y lo arrima al canto de la pantalla. Sigue dentro
       del `flex` de la cabecera y no suelto en `fixed` porque así RESERVA su
       sitio: suelto, entre 1280 y 1536 px se montaba encima de la píldora.

       NO SE VE EN EL MÓVIL (`hidden lg:flex`). Ahí el ancho es lo que escasea:
       el interruptor le robaba sitio a la píldora para ofrecer un ajuste que
       casi nadie toca desde el teléfono. Y no basta con esconderlo: sin él no
       hay forma de volver, así que el móvil se queda SIEMPRE en el tema claro
       —lo fuerza el script de más abajo— en lugar de heredar un modo oscuro
       elegido en el escritorio y quedarse encerrado en él. */
  }
  <div
    class="navbar-theme border-brand-100/40 bg-brand-50/60 hidden h-9 w-9 shrink-0 items-center justify-center self-center rounded-full border backdrop-blur-md lg:-mr-5 lg:flex dark:border-neutral-700/40 dark:bg-neutral-800/80 dark:backdrop-blur-md"
  >
    <ThemeIcon />
  </div>
</header>

{
  /*
    La barra se encoge al bajar y recupera su tamaño al volver al tope.

    Lo que cambia es lo que ocupa sitio —el logo, el alto de los enlaces y la
    separación con el borde superior—, no la forma ni el color: al desplazarse
    la barra deja de presentarse y pasa a ser una herramienta, así que estorba
    menos sin desaparecer.

    La histéresis (encoge pasados 40 px, vuelve por debajo de 12) evita el
    parpadeo cuando el scroll se queda oscilando justo en el umbral, que es lo
    que pasa con un único punto de corte y una rueda de ratón lenta.
  */
}
<style>
  .navbar {
    transition: top 0.28s ease;
  }

  .navbar-logo > :global(span) {
    display: inline-block;
    width: 6rem;
    transition: width 0.28s ease;
  }

  .navbar-links :global(a) {
    transition:
      padding 0.28s ease,
      color 0.3s;
  }

  .navbar.is-scrolled {
    top: 0.5rem;
  }

  /* EL VIDRIO NO SE TOCA DESDE AQUÍ.

     El velo y el desenfoque viven en el marcado, con las utilidades de
     Tailwind —`bg-brand-50/60`, `backdrop-blur-md`, y sus pares para el modo
     oscuro—, y no cambian en toda la vida de la página. Esto se ha intentado
     "mejorar" dos veces, subiendo el velo al desplazarse para ganar contraste,
     y las dos veces el resultado fue el mismo: la barra dejaba de leerse como
     vidrio y pasaba a ser una banda maciza. Es el efecto lo que se está
     pagando; si algo de dentro no se lee, se arregla ESO —el color del texto,
     una placa detrás del logo— y no tapando el fondo.

     Lo único que cambia al desplazarse es el TAMAÑO: la separación con el
     borde, el ancho del logo y el alto de los enlaces. */

  .navbar.is-scrolled .navbar-logo > :global(span) {
    width: 4.5rem;
  }

  @media (min-width: 1024px) {
    .navbar.is-scrolled .navbar-links :global(a) {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
  }

  /* Por debajo de lg la píldora sí tiene relleno propio (py-3): ahí es lo que
     hay que recortar, porque el menú va plegado y el logo manda solo. */
  @media (max-width: 1023px) {
    .navbar-pill {
      transition:
        padding 0.28s ease,
        background-color 0.28s ease,
        box-shadow 0.28s ease;
    }

    .navbar.is-scrolled .navbar-pill {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar-pill,
    .navbar-theme,
    .navbar-logo > :global(span),
    .navbar-links :global(a) {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    // Encoger deja de tener sentido si no hay recorrido: en una página que
    // apenas pasa del alto de la ventana, el nav estaría cambiando de tamaño
    // por 40 píxeles de scroll.
    const RECORRIDO_MINIMO = 320;

    function syncNavbarShrink() {
      const header = document.querySelector('[data-navbar]');
      if (!header) return;

      const recorrido =
        document.documentElement.scrollHeight - window.innerHeight;
      if (recorrido < RECORRIDO_MINIMO) {
        header.classList.remove('is-scrolled');
        return;
      }

      const y = window.scrollY;
      const encogido = header.classList.contains('is-scrolled');
      if (!encogido && y > 40) header.classList.add('is-scrolled');
      else if (encogido && y < 12) header.classList.remove('is-scrolled');
    }

    let pendiente = false;
    window.addEventListener(
      'scroll',
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          pendiente = false;
          syncNavbarShrink();
        });
      },
      { passive: true }
    );

    // Al cargar el navegador puede restaurar la posición anterior, así que el
    // estado inicial se evalúa en vez de darse por supuesto.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncNavbarShrink, {
        once: true,
      });
    } else {
      syncNavbarShrink();
    }
  })();
</script>

{/* Theme Appearance script to manage light/dark modes */}
<script is:inline>
  const HSThemeAppearance = {
    init() {
      const defaultTheme = 'default';
      let theme = localStorage.getItem('hs_theme') || defaultTheme;

      if (document.querySelector('html').classList.contains('dark')) return;
      this.setAppearance(theme);
    },
    _resetStylesOnLoad() {
      const $resetStyles = document.createElement('style');
      $resetStyles.innerText = `*{transition: unset !important;}`;
      $resetStyles.setAttribute('data-hs-appearance-onload-styles', '');
      document.head.appendChild($resetStyles);
      return $resetStyles;
    },
    setAppearance(theme, saveInStore = true, dispatchEvent = true) {
      const $resetStylesEl = this._resetStylesOnLoad();

      if (saveInStore) {
        localStorage.setItem('hs_theme', theme);
      }

      if (theme === 'auto') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'default';
      }

      /* Quién decide si la clase `dark` entra o no es `bysAplicarTema`, la
         función que MainLayout deja resuelta antes de pintar: es la que sabe
         que el modo oscuro solo existe a partir de 1024 px. Aquí se guarda la
         preferencia y se le pide que vuelva a aplicarla. */
      document.querySelector('html').classList.remove('default');
      document.querySelector('html').classList.remove('auto');
      window.bysAplicarTema();

      setTimeout(() => {
        $resetStylesEl.remove();
      });

      if (dispatchEvent) {
        window.dispatchEvent(
          new CustomEvent('on-hs-appearance-change', { detail: theme })
        );
      }
    },
    getAppearance() {
      let theme = this.getOriginalAppearance();
      if (theme === 'auto') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'default';
      }
      return theme;
    },
    getOriginalAppearance() {
      const defaultTheme = 'default';
      return localStorage.getItem('hs_theme') || defaultTheme;
    },
  };
  HSThemeAppearance.init();

  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (HSThemeAppearance.getOriginalAppearance() === 'auto') {
        HSThemeAppearance.setAppearance('auto', false);
      }
    });

  /* Al cruzar el ancho a partir del cual existe el interruptor —girando el
     teléfono, o estirando la ventana en el escritorio— el tema se vuelve a
     resolver. Sin esto, una ventana estrechada se quedaría en oscuro con el
     interruptor ya fuera de pantalla, que es justo el callejón sin salida que
     esta regla viene a evitar. */
  window
    .matchMedia(window.BYS_TEMA_OSCURO_DESDE)
    .addEventListener('change', () => window.bysAplicarTema());

  window.addEventListener('load', () => {
    const $clickableThemes = document.querySelectorAll(
      '[data-hs-theme-click-value]'
    );
    const $switchableThemes = document.querySelectorAll(
      '[data-hs-theme-switch]'
    );

    $clickableThemes.forEach($item => {
      $item.addEventListener('click', () =>
        HSThemeAppearance.setAppearance(
          $item.getAttribute('data-hs-theme-click-value'),
          true,
          $item
        )
      );
    });

    $switchableThemes.forEach($item => {
      $item.addEventListener('change', e => {
        HSThemeAppearance.setAppearance(e.target.checked ? 'dark' : 'default');
      });

      $item.checked = HSThemeAppearance.getAppearance() === 'dark';
    });

    window.addEventListener('on-hs-appearance-change', e => {
      $switchableThemes.forEach($item => {
        $item.checked = e.detail === 'dark';
      });
    });
  });
</script>
