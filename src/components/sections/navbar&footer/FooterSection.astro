---
/**
 * Pie del sitio.
 *
 * Dos piezas, de arriba abajo:
 *
 *   1. La rejilla: marca y datos de la empresa, y las columnas de enlaces
 *      (Productos, Recursos, Empresa, Legal).
 *   2. La barra inferior: identidad legal —razón social y NIT— y redes.
 *
 * AQUÍ NO HAY SUSCRIPCIÓN, y no es un olvido. La había, y quedó duplicada
 * cuando la portada estrenó su cierre con el boletín en una tarjeta propia
 * (CierreSection.astro): el mismo formulario dos veces en la misma pantalla no
 * suma suscriptores, resta claridad. Se quedó la de arriba, que es la que
 * explica qué se recibe al suscribirse; el pie volvió a ser lo que tiene que
 * ser: dónde encontrar a la empresa y a dónde ir.
 *
 * La columna «Legal» no se escribe aquí: sale de `strings.legalLinks`, que a
 * su vez sale de `LEGAL.documentos` en constants.ts. Es la misma lista de la
 * que nacen las tres páginas legales, así que ninguna puede quedar publicada
 * sin enlace en el footer.
 *
 * SOBRE LA RAZÓN SOCIAL de la barra inferior: usa `LEGAL.entidad.razonSocial`
 * («BYS LOGISTICS S.A.S.»), no `SITE.legalName`. Es la línea de identidad
 * legal del sitio, y tiene que decir lo mismo que los documentos que enlaza
 * justo encima. Ver la nota de `LEGAL` en constants.ts.
 */
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import strings from '@utils/navigation.ts';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { CONTACT, LEGAL, SITE } from '@data/constants';
// Only render the social icons that actually have a URL configured, so the
// footer never links out to a placeholder profile.
const socialIcons = [
  { key: 'facebook', label: 'Facebook', icon: 'facebookFooter' },
  { key: 'instagram', label: 'Instagram', icon: 'instagramFooter' },
  { key: 'linkedin', label: 'LinkedIn', icon: 'linkedinFooter' },
  { key: 'x', label: 'X', icon: 'xFooter' },
] as const;

const activeSocials = socialIcons.filter(
  ({ key }) => (strings.socialLinks as Record<string, string>)[key]
);

// Clase común de los enlaces de las columnas. El alto mínimo de 11 (44 px) en
// pantalla pequeña es el área táctil que pide la WCAG; a partir de `md` se
// suelta, porque con puntero la lista compacta se lee mejor.
const linkClass =
  'inline-flex min-h-11 items-center gap-x-2 rounded-lg py-1 text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-800 focus-visible:ring-3 md:min-h-0 md:py-0 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-200 dark:focus:outline-hidden';
---

<footer class="w-full bg-neutral-300 dark:bg-neutral-900">
  <div
    class="mx-auto w-full max-w-[85rem] px-10 py-14 sm:px-14 lg:px-20 lg:pt-20"
  >
    {
      /*
      La rejilla crece de 2 columnas a 6 y a 6: en `lg` son marca (2) y las
      CUATRO columnas de enlaces —Productos, Recursos, Empresa y Legal—, una
      cada una. Eran 7 cuando el pie llevaba la suscripción; al quitarla hay
      que bajar a 6 exactos, ni más ni menos: con 7 quedaba un hueco a la
      derecha, y con 5 la columna «Legal» no cabía y se caía a un segundo
      renglón, debajo de la dirección de la empresa.
    */
    }
    <div
      class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-6 lg:grid-cols-6"
    >
      <div class="col-span-2 md:col-span-6 lg:col-span-2">
        {/* Brand Logo */}
        <BrandLogo class="h-auto w-32" />

        <p class="mt-5 max-w-sm text-sm text-neutral-600 dark:text-neutral-400">
          {SITE.description_short}
        </p>

        {
          /*
          Los datos de la empresa en el footer no son decorativos: en un sitio
          B2B son lo que un comprador busca para verificar con quién trata
          antes de escribir. `<address>` es el elemento que les corresponde;
          va sin cursiva porque el navegador la pone de fábrica.
        */
        }
        <address
          class="mt-5 grid gap-y-1 text-sm text-neutral-600 not-italic dark:text-neutral-400"
        >
          <span>{CONTACT.address}</span>
          <span>{CONTACT.city}</span>
          <a href={CONTACT.pbx[0].href} class={linkClass}>
            {CONTACT.pbx[0].label}
          </a>
          <a href={`mailto:${CONTACT.email}`} class={linkClass}>
            {CONTACT.email}
          </a>
        </address>
      </div>

      {/* An array of links for Product and Company sections */}
      {
        strings.footerLinks.map(section => (
          <div class="col-span-1 md:col-span-2 lg:col-span-1">
            <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
              {section.section}
            </h3>
            <ul class="mt-3 grid space-y-3">
              {section.links.map(link => (
                <li>
                  <a href={link.url} class={linkClass}>
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {/* Documentos legales: términos, privacidad y tratamiento de datos. */}
      <div class="col-span-1 md:col-span-2 lg:col-span-1">
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">Legal</h3>
        <ul class="mt-3 grid space-y-3">
          {
            strings.legalLinks.map(link => (
              <li>
                <a href={link.url} class={linkClass}>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      /*
      Barra inferior. Lleva la identidad legal completa —razón social y NIT—
      porque es el dato con el que se comprueba una empresa colombiana, y
      porque acompaña a los documentos que la rejilla acaba de enlazar.
    */
    }
    <div
      class="mt-12 flex flex-col gap-y-4 border-t border-neutral-400/60 pt-8 sm:flex-row sm:items-center sm:justify-between sm:gap-y-0 dark:border-neutral-700"
    >
      <div class="text-sm text-neutral-600 dark:text-neutral-400">
        <p>
          {
            /*
            Sin punto después de la razón social: ya termina en uno («S.A.S.»)
            y se veían dos seguidos.
          */
          }
          © <span id="current-year"></span>{` `}
          {LEGAL.entidad.razonSocial} Todos los derechos reservados.
        </p>
        <p class="mt-1">NIT {LEGAL.entidad.nit}</p>
      </div>

      {/* Social Brands */}
      <div class="-ml-2 flex items-center sm:ml-0">
        {
          activeSocials.map(social => (
            <FooterSocialLink
              url={(strings.socialLinks as Record<string, string>)[social.key]}
              label={social.label}
            >
              <Icon name={social.icon} />
            </FooterSocialLink>
          ))
        }
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
