---
// Import PrimaryCTA component
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SectionBackdrop from '@components/ui/blocks/SectionBackdrop.astro';

// Destructure the props passed to the Astro component
const {
  title,
  subTitle,
  btnExists,
  btnTitle,
  btnURL,
  backdrop,
  backdropTreatment = 'mate',
} = Astro.props;
// Define TypeScript interface for props
interface Props {
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  /** Imagen de fondo, a la derecha del encabezado. */
  backdrop?: ImageMetadata;
  /** `photo` deja la imagen nítida; solo para ilustraciones. */
  backdropTreatment?: 'mate' | 'photo';
}
---

{/* Root section of the component */}
<section class="relative overflow-hidden">
  {
    backdrop && (
      <SectionBackdrop
        src={backdrop}
        side="right"
        width="50%"
        treatment={backdropTreatment}
      />
    )
  }

  <div
    class="relative mx-auto max-w-[85rem] px-10 py-16 sm:px-14 lg:px-20 lg:py-24"
  >
    {
      /* Escalona la entrada de lo que hay dentro —titular, párrafo y botón— en
        lugar de meterlos de golpe. Es el encabezado de casi todas las páginas
        interiores, así que este atributo solo hace que media web entre con el
        mismo gesto que el cierre de la portada.

        `entrada` y no `cascada` porque esto se ve SIN hacer scroll: la cascada
        la revela un observador de JavaScript, y arriba del todo eso deja al
        titular escondido los milisegundos que tarda en cargar el módulo. La
        entrada es CSS puro y arranca en el primer fotograma. Ver global.css. */
    }
    <div class="max-w-2xl" data-anim-entrada>
      {/* Section title */}
      <h1
        class="mb-5 text-4xl font-extrabold tracking-tight text-balance text-neutral-800 sm:text-5xl lg:text-6xl dark:text-neutral-100"
      >
        {title}
      </h1>
      {/* Section subtitle */}
      <p
        class="max-w-prose text-lg leading-relaxed font-normal text-pretty text-neutral-600 sm:text-xl dark:text-neutral-400"
      >
        {subTitle}
      </p>
      {
        /* Conditional rendering of PrimaryCTA component if 'btnExists' property is truthy */
      }
      {
        btnExists ? (
          <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
            <PrimaryCTA title={btnTitle} url={btnURL} size="lg" />
          </div>
        ) : null
      }
    </div>
  </div>
</section>
