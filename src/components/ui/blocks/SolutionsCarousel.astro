---
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';

/**
 * Carrusel de soluciones para la portada.
 *
 * Ocupa el ancho completo y casi todo el alto de la ventana: una línea de
 * producto por diapositiva, con la foto grande, el titular y una sola frase.
 * La portada resume y remite; el listado de /productos detalla.
 *
 * DECISIONES QUE NO SON DE ESTILO
 *
 * · **Avanza solo, pero se para en cuanto hay alguien.** El temporizador se
 *   detiene con el puntero encima, con el foco de teclado dentro, con la
 *   pestaña en segundo plano y cuando el carrusel sale de la pantalla. Un
 *   carrusel que sigue corriendo mientras alguien lee es la forma más rápida
 *   de que se pierda de vista justo la diapositiva que interesaba.
 *
 *   OJO CON LAS DOS PAUSAS, que es donde estuvo el bug que dejaba el carrusel
 *   MUERTO EN EL MÓVIL de un solo toque:
 *
 *     · La del puntero solo vale donde hay puntero de verdad (`hover: hover`).
 *       Al tocar la pantalla, el navegador sintetiza un `mouseenter` que nunca
 *       tiene su `mouseleave`: el carrusel se pausaba con el primer toque y ya
 *       no volvía a moverse en toda la visita.
 *     · La del foco solo vale para el foco de TECLADO (`:focus-visible`).
 *       Tocar una flecha o un punto también deja el foco dentro, así que
 *       cambiar de diapositiva a mano equivalía a apagar el automático.
 *
 * · **Con `prefers-reduced-motion` no se mueve solo.** Ni temporizador ni
 *   acercamiento de la foto: quedan las flechas, los puntos y el arrastre.
 *
 * · **La foto va contenida sobre un fondo claro, no recortada a sangre.** Son
 *   fotos de producto sobre blanco, verticales muchas de ellas: recortarlas
 *   para llenar media pantalla dejaría el producto fuera de cuadro. Por eso la
 *   diapositiva se divide en dos —el texto sobre el azul de marca, la foto
 *   sobre su plano claro— en lugar de poner el texto encima de la imagen.
 *
 * · **Sin JavaScript sigue siendo utilizable.** La primera diapositiva se
 *   pinta activa desde el servidor y cada una es un enlace a su línea.
 */
interface Solucion {
  id: string;
  title: string;
  /** Una sola frase. Si viene larga, la diapositiva deja de ser una portada. */
  subtitle: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  soluciones: Solucion[];
  /** Milisegundos que dura cada diapositiva antes de pasar sola. */
  intervalo?: number;
}

/*
 * 4,2 SEGUNDOS POR DIAPOSITIVA.
 *
 * Eran 6,5 y la portada parecía parada: con seis líneas, dar la vuelta entera
 * costaba casi cuarenta segundos, así que quien bajaba por la página veía una
 * sola diapositiva y se iba creyendo que el carrusel era una foto fija.
 *
 * 4,2 s es lo que se tarda en leer un titular y una frase de una línea, que es
 * todo lo que hay en cada diapositiva. Y no hace falta más margen: el
 * temporizador se detiene solo en cuanto alguien se para a mirar (ver arriba).
 */
const { soluciones, intervalo = 4200 } = Astro.props;
const total = soluciones.length;

/**
 * Un acento por diapositiva, recorriendo la rampa de marca.
 *
 * No es decoración: es lo que hace que pasar de una a otra se NOTE. Con el
 * mismo azul en las seis, el cambio solo se percibía en el titular, y a media
 * pantalla de distancia parecía que el carrusel estaba parado.
 */
const ACENTOS = [
  'var(--color-brand-300)',
  'var(--color-brand-400)',
  'var(--color-brand-200)',
  'var(--color-brand-500)',
  'var(--color-brand-300)',
  'var(--color-brand-400)',
];
---

<section
  class="slider"
  data-slider
  data-intervalo={intervalo}
  style={`--reloj:${intervalo}ms`}
  role="region"
  aria-roledescription="carrusel"
  aria-label="Nuestras soluciones"
>
  <div class="slider-marco" data-slider-marco>
    <div class="slider-pista">
      {
        soluciones.map((solucion, i) => (
          <div
            class:list={[
              'slide',
              // Las diapositivas impares invierten la composición: la foto pasa
              // a la izquierda y el texto a la derecha. Seis pantallas idénticas
              // seguidas se leen como una sola repetida.
              i % 2 === 1 && 'slide--invertida',
              i === 0 && 'is-activa',
            ]}
            style={`--acento:${ACENTOS[i % ACENTOS.length]}; --giro:${(i % 3) * 24 - 24}deg`}
            data-slide
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${total}: ${solucion.title}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            {/* Capas de fondo: el resplandor que deriva y el número gigante.
                Ambas decorativas, ambas fuera del árbol de accesibilidad. */}
            <div class="slide-resplandor" aria-hidden="true" />
            <span class="slide-fantasma" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="slide-texto">
              <p class="slide-orden anim">
                <span class="slide-orden-num">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="slide-orden-sep" aria-hidden="true" />
                <span>Nuestras soluciones</span>
              </p>
              <h3 class="slide-titulo anim">{solucion.title}</h3>
              <p class="slide-linea anim">{solucion.subtitle}</p>
              <a
                href={`/productos/${solucion.id}`}
                class="slide-cta anim"
                data-astro-prefetch
                tabindex={i === 0 ? undefined : '-1'}
              >
                Ver la línea
                <span class="slide-cta-flecha">
                  <Icon name="arrowRight" />
                </span>
              </a>
            </div>

            <div class="slide-media">
              <div class="slide-plano">
                <span class="slide-halo" aria-hidden="true" />
                {solucion.image && (
                  <Image
                    src={solucion.image}
                    alt={solucion.imageAlt ?? solucion.title}
                    class="slide-foto"
                    widths={[480, 720, 1080]}
                    sizes="(min-width: 1024px) 45vw, 90vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    draggable={false}
                  />
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {
      total > 1 && (
        <>
          <button
            type="button"
            class="slider-flecha slider-flecha-prev"
            data-slider-prev
            aria-label="Ver la solución anterior"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            class="slider-flecha slider-flecha-next"
            data-slider-next
            aria-label="Ver la siguiente solución"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>

          {/* Los puntos hacen de índice y de reloj: el activo se alarga y se
              va llenando con lo que queda de la diapositiva. */}
          <div class="slider-puntos">
            {soluciones.map((solucion, i) => (
              <button
                type="button"
                class:list={['slider-punto', i === 0 && 'is-activo']}
                data-slider-punto={i}
                aria-current={i === 0 ? 'true' : 'false'}
                aria-label={`Ir a ${solucion.title}`}
              >
                <span class="slider-punto-relleno" data-slider-relleno />
              </button>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<script>
  function initSolutionsCarousel() {
    const root = document.querySelector<HTMLElement>('[data-slider]');
    if (!root) return;
    if (root.dataset.listo === 'true') return;

    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('[data-slide]')
    );
    if (slides.length < 2) return;
    root.dataset.listo = 'true';

    const marco = root.querySelector<HTMLElement>('[data-slider-marco]')!;
    const puntos = Array.from(
      root.querySelectorAll<HTMLElement>('[data-slider-punto]')
    );
    const intervalo = Number(root.dataset.intervalo) || 4200;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');
    /* Solo donde hay puntero de verdad. Ver la nota de la cabecera: en una
       pantalla táctil el `mouseenter` sintético del primer toque no trae
       `mouseleave`, y el carrusel se quedaba pausado para siempre. */
    const conPuntero = window.matchMedia('(hover: hover)');

    let actual = 0;
    let temporizador: number | undefined;

    /**
     * `visibilidad` guarda por qué está parado el carrusel. Son cuatro motivos
     * independientes —puntero, foco, pestaña y estar fuera de pantalla— y
     * cualquiera de ellos basta para detenerlo; con un único booleano, salir
     * con el ratón reanudaba un carrusel que la pestaña oculta había parado.
     */
    const motivos = new Set<string>();

    const pausar = (motivo: string) => {
      motivos.add(motivo);
      root.dataset.pausado = 'true';
      window.clearTimeout(temporizador);
    };

    const reanudar = (motivo: string) => {
      motivos.delete(motivo);
      if (motivos.size > 0) return;
      root.dataset.pausado = 'false';
      programar();
    };

    function programar() {
      window.clearTimeout(temporizador);
      if (quieto.matches || motivos.size > 0) return;
      temporizador = window.setTimeout(() => ir(actual + 1, 1), intervalo);
    }

    /** Reinicia la animación de la barra del punto activo. */
    function reiniciarReloj() {
      const relleno = puntos[actual]?.querySelector<HTMLElement>(
        '[data-slider-relleno]'
      );
      if (!relleno) return;
      relleno.style.animation = 'none';
      // Forzar el reflujo: sin esto el navegador agrupa las dos asignaciones
      // y la animación nunca vuelve a arrancar.
      void relleno.offsetWidth;
      relleno.style.animation = '';
    }

    function ir(destino: number, direccion: number) {
      const siguiente = (destino + slides.length) % slides.length;
      if (siguiente === actual) return;

      const saliendo = slides[actual];
      const entrando = slides[siguiente];

      // `root!`: `ir` es una declaración de función, así que TypeScript la
      // considera alcanzable antes de la comprobación de arriba y pierde el
      // estrechamiento del tipo.
      root!.style.setProperty('--dir', String(direccion));

      saliendo.classList.remove('is-activa');
      saliendo.classList.add('is-saliendo');
      saliendo.setAttribute('aria-hidden', 'true');
      saliendo.querySelector('a')?.setAttribute('tabindex', '-1');

      entrando.classList.remove('is-saliendo');
      entrando.classList.add('is-activa');
      entrando.setAttribute('aria-hidden', 'false');
      entrando.querySelector('a')?.removeAttribute('tabindex');

      // La clase de salida se retira cuando termina la transición; si se
      // quitara de inmediato, la diapositiva saliente desaparecería de golpe.
      window.setTimeout(() => saliendo.classList.remove('is-saliendo'), 620);

      puntos.forEach((punto, i) => {
        punto.classList.toggle('is-activo', i === siguiente);
        punto.setAttribute('aria-current', i === siguiente ? 'true' : 'false');
      });

      actual = siguiente;
      reiniciarReloj();
      programar();
    }

    root
      .querySelector('[data-slider-prev]')
      ?.addEventListener('click', () => ir(actual - 1, -1));
    root
      .querySelector('[data-slider-next]')
      ?.addEventListener('click', () => ir(actual + 1, 1));

    puntos.forEach((punto, i) => {
      punto.addEventListener('click', () => ir(i, i > actual ? 1 : -1));
    });

    root.addEventListener('mouseenter', () => {
      if (conPuntero.matches) pausar('puntero');
    });
    root.addEventListener('mouseleave', () => reanudar('puntero'));

    /* El foco pausa solo si es de TECLADO. Tocar una flecha o un punto también
       deja el foco dentro; si eso pausara, pasar de diapositiva a mano
       apagaría el automático de por vida. `:focus-visible` es justo la
       distinción que hace falta, y la resuelve el navegador. */
    root.addEventListener('focusin', event => {
      const objetivo = event.target as HTMLElement | null;
      if (objetivo?.matches(':focus-visible')) pausar('foco');
    });
    root.addEventListener('focusout', () => reanudar('foco'));

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pausar('pestana');
      else reanudar('pestana');
    });

    // Fuera de pantalla no hay nada que mirar: el temporizador se detiene para
    // no llegar de vuelta con la diapositiva cambiada sin motivo.
    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        entradas => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) reanudar('fuera');
            else pausar('fuera');
          }
        },
        { threshold: 0.25 }
      );
      observador.observe(root);
    }

    // Teclado: flechas cuando el foco está dentro del carrusel.
    root.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') ir(actual - 1, -1);
      else if (event.key === 'ArrowRight') ir(actual + 1, 1);
    });

    // Arrastre. Se mira solo el gesto horizontal: uno vertical es alguien
    // bajando por la página, no cambiando de diapositiva. Con eventos de
    // puntero, así vale igual para el dedo, el ratón y el lápiz.
    let inicioX = 0;
    let inicioY = 0;
    let arrastrando = false;

    marco.addEventListener('pointerdown', event => {
      // Solo el botón principal, y nunca desde un control: arrastrar por
      // encima de una flecha no debe contar como gesto.
      if (event.button !== 0) return;
      if ((event.target as HTMLElement | null)?.closest('button, a')) return;
      arrastrando = true;
      inicioX = event.clientX;
      inicioY = event.clientY;
    });

    marco.addEventListener('pointerup', event => {
      if (!arrastrando) return;
      arrastrando = false;
      const dx = event.clientX - inicioX;
      const dy = event.clientY - inicioY;
      // 44 px y no 60: en una pantalla de 390 px, sesenta píxeles son un gesto
      // largo y el arrastre no respondía a un deslizamiento normal del pulgar.
      if (Math.abs(dx) < 44 || Math.abs(dx) < Math.abs(dy)) return;
      ir(actual + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });

    marco.addEventListener('pointercancel', () => {
      arrastrando = false;
    });

    /*
     * PARALAJE DEL PRODUCTO.
     *
     * La foto se desplaza un poco hacia donde está el puntero. Es lo que
     * convierte una fotografía pegada al fondo en un objeto que ocupa espacio:
     * el movimiento es de catorce píxeles como mucho, y aun así se nota.
     *
     * Se escribe en dos variables CSS y no se toca el estilo directamente, y
     * se hace dentro de un `requestAnimationFrame`: `pointermove` dispara
     * decenas de veces por segundo y no hace falta escribir en cada una.
     */
    let pendiente = false;
    let ultimoEvento: PointerEvent | null = null;

    marco.addEventListener(
      'pointermove',
      event => {
        if (quieto.matches) return;
        ultimoEvento = event;
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          pendiente = false;
          const caja = marco.getBoundingClientRect();
          if (!ultimoEvento) return;
          const x = (ultimoEvento.clientX - caja.left) / caja.width - 0.5;
          const y = (ultimoEvento.clientY - caja.top) / caja.height - 0.5;
          root!.style.setProperty(
            '--px',
            String(Math.max(-1, Math.min(1, x * 2)))
          );
          root!.style.setProperty(
            '--py',
            String(Math.max(-1, Math.min(1, y * 2)))
          );
        });
      },
      { passive: true }
    );

    // Al salir, la foto vuelve a su sitio en lugar de quedarse descentrada.
    marco.addEventListener('pointerleave', () => {
      root!.style.setProperty('--px', '0');
      root!.style.setProperty('--py', '0');
    });

    quieto.addEventListener('change', programar);
    reiniciarReloj();
    programar();
  }

  initSolutionsCarousel();
  document.addEventListener('astro:page-load', initSolutionsCarousel);
</script>

<style>
  .slider {
    --dir: 1;
    position: relative;
    width: 100%;
  }

  .slider-marco {
    position: relative;
    overflow: hidden;
    /* Casi toda la ventana, pero con techo y suelo: en una pantalla apaisada
       de portátil, 80vh sin más deja la diapositiva por debajo del pliegue. */
    height: clamp(34rem, 82vh, 48rem);
    background:
      radial-gradient(
        120% 100% at 0% 0%,
        var(--color-brand-700) 0%,
        transparent 60%
      ),
      linear-gradient(
        135deg,
        var(--color-brand-900) 0%,
        var(--color-brand-800) 55%,
        var(--color-brand-950) 100%
      );
  }

  /* Trama de puntos por encima del degradado. Es lo que le quita el aspecto de
     fondo plano de plantilla: da textura sin competir con nada, porque a este
     tamaño no se lee como dibujo sino como grano. */
  .slider-marco::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    background-image: radial-gradient(
      rgb(255 255 255 / 0.09) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 0%, transparent 75%);
  }

  .slider-pista {
    position: absolute;
    inset: 0;
  }

  /* ---------- DIAPOSITIVA ---------- */
  /*
     EL CAMBIO DE DIAPOSITIVA: MÁS CORTO Y CON MÁS RECORRIDO.

     Era una transición de 0,7 s recorriendo 2,5 rem, y a esa velocidad y con
     ese recorrido el cambio se leía como un fundido: la diapositiva no parecía
     entrar desde ningún lado, simplemente aparecía. Ahora son 0,55 s de
     entrada —el ojo la registra como un movimiento— sobre 5 rem, que es lo que
     hace que se vea DE DÓNDE viene y hacia dónde va. La curva sigue siendo la
     misma `cubic-bezier(0.22, 1, 0.36, 1)`: arranca rápido y frena al final,
     que es lo que le quita el aire mecánico. */
  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(calc(var(--dir) * 5rem), 0, 0) scale(0.97);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.55s;
  }

  .slide.is-activa {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    z-index: 2;
    transition-delay: 0s;
  }

  /* La que se va sale hacia el lado contrario al del avance, y algo más
     deprisa que lo que tarda en entrar la siguiente: así no se solapan las dos
     a media opacidad, que es lo que emborronaba el cambio. */
  .slide.is-saliendo {
    visibility: visible;
    opacity: 0;
    transform: translate3d(calc(var(--dir) * -4rem), 0, 0) scale(0.97);
    transition-duration: 0.45s;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .slide {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    /* La composición se invierte en las impares. Se hace con `order` y no
       cambiando el marcado: el orden de lectura —titular, frase, enlace y
       luego la foto— tiene que seguir siendo el mismo para quien navega con
       teclado o lector de pantalla. */
    .slide--invertida .slide-texto {
      order: 2;
      padding: 4rem clamp(2.5rem, 7vw, 8rem) 4rem 4rem;
    }

    .slide--invertida .slide-media {
      order: 1;
      padding: 2.5rem 0 2.5rem 2.5rem;
    }
  }

  /* Resplandor del color de la diapositiva. Deriva despacio y en bucle: es el
     movimiento de fondo que hace que la pantalla nunca esté del todo quieta,
     y el que más se nota con el rabillo del ojo. */
  .slide-resplandor {
    position: absolute;
    top: -25%;
    right: -15%;
    width: 70%;
    height: 120%;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--acento) 46%, transparent) 0%,
      transparent 65%
    );
    filter: blur(40px);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .slide--invertida .slide-resplandor {
    right: auto;
    left: -15%;
  }

  .slide.is-activa .slide-resplandor {
    opacity: 1;
    animation: slide-deriva 9s ease-in-out infinite alternate;
  }

  @keyframes slide-deriva {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-6%, 5%, 0) scale(1.18);
    }
  }

  /* El número gigante. Marca en qué punto del recorrido va sin tener que
     contar los puntos de abajo, y le da profundidad a la composición. */
  .slide-fantasma {
    position: absolute;
    top: 50%;
    left: -0.08em;
    z-index: 0;
    font-size: clamp(14rem, 34vw, 30rem);
    font-weight: 800;
    line-height: 0.75;
    letter-spacing: -0.06em;
    color: rgb(255 255 255 / 0.045);
    pointer-events: none;
    user-select: none;
    transform: translate3d(0, -50%, 0) rotate(var(--giro, 0deg));
    transform-origin: left center;
  }

  .slide--invertida .slide-fantasma {
    left: auto;
    right: -0.08em;
    transform-origin: right center;
  }

  .slide.is-activa .slide-fantasma {
    animation: slide-fantasma-entra 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes slide-fantasma-entra {
    from {
      opacity: 0;
      transform: translate3d(calc(var(--dir) * 4rem), -50%, 0)
        rotate(var(--giro, 0deg)) scale(1.15);
    }
    to {
      opacity: 1;
      transform: translate3d(0, -50%, 0) rotate(var(--giro, 0deg)) scale(1);
    }
  }

  /* ---------- TEXTO ---------- */
  .slide-texto {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    padding: 2rem 1.75rem 3.5rem;
    color: #fff;
    order: 2;
  }

  @media (min-width: 640px) {
    .slide-texto {
      padding: 2.5rem 3.5rem 4rem;
    }
  }

  @media (min-width: 1024px) {
