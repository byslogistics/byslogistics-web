---
import { SITE, CONTACT } from '@data/constants';

/**
 * Asistente del sitio: burbuja flotante que responde con la información
 * publicada en la propia página.
 *
 * Tres decisiones que no son de estilo:
 *
 * 1. **Va abajo a la DERECHA, donde estaba el botón de WhatsApp.** Es el sitio
 *    donde se busca la ayuda, y ahora está libre: el cotizador se subió a la
 *    barra de navegación y el atajo a WhatsApp vive dentro de esta burbuja
 *    —en el saludo, en el pie y en cuanto el asistente no sabe algo—, así que
 *    no se pierde la vía directa con una persona, se gana una antes.
 *
 * 2. **Las sugerencias iniciales no son decorado.** Dirigen la conversación
 *    hacia preguntas que la base de conocimiento responde bien. Con un modelo
 *    pequeño, encauzar la pregunta vale más que afinar el prompt.
 *
 * 3. **Degrada a persona, no a error.** Si `/api/chat` no existe (una preview
 *    estática, la función sin desplegar) o falla, el widget lo detecta al
 *    primer intento y se convierte en un atajo al WhatsApp y al formulario en
 *    vez de quedarse roto.
 *
 * El backend está en netlify/functions/chat.mts y la base de conocimiento se
 * genera en el build (src/pages/kb.json.ts). La clave del proveedor vive solo
 * en las variables de entorno de Netlify: el navegador nunca la ve.
 */

const sugerencias = [
  '¿Qué tipos de precintos manejan?',
  '¿Cómo pido una cotización?',
  '¿Los precintos se personalizan?',
  '¿A qué sectores atienden?',
  '¿Atienden fuera de Colombia?',
];
---

<div class="chat" data-chat>
  {
    /* El botón va envuelto en su propio contenedor porque la llamada de
       atención lo MUEVE: si el `transform` de la sacudida y el del `:hover`
       viven en el mismo elemento, el que llega segundo pisa al primero y el
       botón se queda torcido a medio camino. El envoltorio se sacude, el
       botón conserva su hover. */
  }
  <div class="chat-llamada">
    <span class="chat-pulso" aria-hidden="true"></span>
    <button
      class="chat-launcher"
      type="button"
      data-chat-toggle
      aria-expanded="false"
      aria-controls="chat-panel"
    >
      {
        /*
          EL ICONO NO ESTÁ DIBUJADO AQUÍ: es `chat-dots-fill` de Bootstrap
          Icons (MIT), copiado tal cual. Hubo dos intentos de dibujar el globo
          a mano y los dos se veían mal a 32 px; uno hecho por gente que dibuja
          iconos aguanta el tamaño.

          Y OJO CON EL `viewBox`, QUE NO ES EL ORIGINAL. El de Bootstrap es
          `0 0 16 16`, pero la tinta del dibujo va de y=1 a y=15,93: está 0,47
          más abajo del centro de su propia caja. Al escalarlo dentro de un
          cuadrado, ese medio punto se convierte en un icono que se ve caído.
          El `viewBox` de aquí es la caja MEDIDA del dibujo, cuadrada y centrada
          en él, así que lo que se ve queda en el centro exacto. Si algún día se
          cambia de icono hay que volver a medirlo: el `viewBox` que trae un
          archivo SVG casi nunca coincide con lo que hay pintado dentro.
        */
      }
      <span class="chat-launcher-icon" aria-hidden="true">
        <svg viewBox="0 0.47 16 16" fill="currentColor">
          <path
            d="M16 8c0 3.866-3.582 7-8 7a9 9 0 0 1-2.347-.306c-.584.296-1.925.864-4.181 1.234-.2.032-.352-.176-.273-.362.354-.836.674-1.95.77-2.966C.744 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7M5 8a1 1 0 1 0-2 0 1 1 0 0 0 2 0m4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"
          ></path>
        </svg>
      </span>
      <span class="chat-launcher-label">Asistente</span>
    </button>
  </div>

  <section
    class="chat-panel"
    id="chat-panel"
    data-chat-panel
    hidden
    aria-label={`Asistente de ${SITE.title}`}
  >
    <header class="chat-head">
      <div>
        <p class="chat-title">Asistente de {SITE.title}</p>
        <p class="chat-sub">Resuelve dudas sobre productos y cotizaciones</p>
      </div>
      <button
        class="chat-close"
        type="button"
        data-chat-close
        aria-label="Cerrar el asistente"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </header>

    <div
      class="chat-log"
      data-chat-log
      data-lenis-prevent
      role="log"
      aria-live="polite"
      aria-atomic="false"
    >
      <div class="chat-msg is-bot">
        <p>
          Pregúnteme lo que necesite sobre precintos, tulas, cajas de seguridad
          o cómo cotizar. Si no lo sé, le paso con una persona del equipo.
        </p>
        {
          /* El atajo a WhatsApp desde el primer mensaje: quien entra buscando
             hablar con alguien no tiene que leerse una respuesta antes. */
        }
        <div class="chat-actions">
          <a
            class="chat-action"
            href={CONTACT.whatsapp}
            target="_blank"
            rel="noopener noreferrer">Escribir por WhatsApp</a
          >
        </div>
      </div>
      <div class="chat-suggestions" data-chat-suggestions>
        {
          sugerencias.map(s => (
            <button type="button" class="chat-chip" data-chat-suggestion={s}>
              {s}
            </button>
          ))
        }
      </div>
    </div>

    <form class="chat-form" data-chat-form>
      <label class="sr-only" for="chat-input">Escriba su pregunta</label>
      <input
        id="chat-input"
        type="text"
        name="q"
        placeholder="Escriba su pregunta…"
        autocomplete="off"
        maxlength="500"
        data-chat-input
      />
      <button
        type="submit"
        class="chat-send"
        data-chat-send
        aria-label="Enviar pregunta"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m22 2-7 20-4-9-9-4 20-7Z"></path>
        </svg>
      </button>
    </form>

    {
      /* El espacio antes del enlace va explícito: el minificador del build
         colapsa el salto de línea entre el texto y la etiqueta, y quedaba
         "sitio.Hablar con una persona" todo junto. */
    }
    <p class="chat-foot">
      Respuestas generadas con la información publicada en el sitio.{' '}
      <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer"
        >Hablar con una persona</a
      >
    </p>
  </section>
</div>

<script
  is:inline
  define:vars={{ whatsapp: CONTACT.whatsapp, correo: CONTACT.email }}
>
  (() => {
    const root = document.querySelector('[data-chat]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const panel = root.querySelector('[data-chat-panel]');
    const toggle = root.querySelector('[data-chat-toggle]');
    const closeBtn = root.querySelector('[data-chat-close]');
    const log = root.querySelector('[data-chat-log]');
    const form = root.querySelector('[data-chat-form]');
    const input = root.querySelector('[data-chat-input]');
    const send = root.querySelector('[data-chat-send]');
    const suggestions = root.querySelector('[data-chat-suggestions]');

    /** Historial que se manda al servidor. Corto: el backend re-recupera cada turno. */
    const history = [];
    let busy = false;
    let endpointDown = false;

    /*
     * Con el dedo NO se enfoca el campo al abrir.
     *
     * En el escritorio, poner el cursor en el campo ahorra un clic. En el
     * teléfono hace lo contrario: sube el teclado de golpe y se come media
     * pantalla, tapando justo el saludo y las preguntas sugeridas, que son lo
     * que hay que leer antes de escribir. `(pointer: fine)` distingue el ratón
     * del dedo mejor que el ancho de la pantalla.
     */
    const conPuntero = window.matchMedia('(pointer: fine)');

    const open = () => {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      if (conPuntero.matches) input.focus();
    };
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
      toggle.focus();
    };

    toggle.addEventListener('click', () => {
      if (panel.hidden) open();
      else close();
    });
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    function bubble(text, who, extraHtml) {
      const el = document.createElement('div');
      el.className = `chat-msg is-${who}`;
      const p = document.createElement('p');
      // textContent y no innerHTML: lo que llega del modelo se pinta como
      // texto, nunca como marcado.
      p.textContent = text;
      el.appendChild(p);
      if (extraHtml) {
        const extra = document.createElement('div');
        extra.className = 'chat-actions';
        extra.innerHTML = extraHtml;
        el.appendChild(extra);
      }
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function thinking() {
      const el = document.createElement('div');
      el.className = 'chat-msg is-bot is-thinking';
      el.innerHTML = '<span></span><span></span><span></span>';
      el.setAttribute('aria-label', 'Escribiendo');
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    /** Sin backend, el asistente se vuelve un atajo útil en lugar de un error. */
    function offlineAnswer() {
      return bubble(
        'El asistente no está disponible en este momento. Le dejo las dos vías directas con el equipo:',
        'bot',
        `<a class="chat-action" href="${whatsapp}" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>` +
          `<a class="chat-action" href="mailto:${correo}">Escribir a ${correo}</a>`
      );
    }

    async function ask(text) {
      if (busy || !text.trim()) return;
      busy = true;
      send.disabled = true;
      suggestions?.remove();

      bubble(text, 'user');
      history.push({ role: 'user', content: text });
      input.value = '';

      if (endpointDown) {
        offlineAnswer();
        busy = false;
        send.disabled = false;
        return;
      }

      const dots = thinking();
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-6) }),
        });

        // 404/405 = no hay función desplegada. 403 = el endpoint no reconoce
        // este origen (un navegador que no manda ni Origin ni Referer). En los
        // tres casos no hay nada que reintentar: se pasa a modo atajo.
        if (res.status === 404 || res.status === 405 || res.status === 403) {
          endpointDown = true;
          dots.remove();
          offlineAnswer();
          return;
        }

        const data = await res.json();
        dots.remove();
        const reply = data.reply || 'No pude responder eso.';
        history.push({ role: 'assistant', content: reply });

        // Cuando la respuesta deriva a cotizar, se ofrece el atajo al
        // catálogo, que es donde se arma la lista.
        const wantsQuote = /cotiza|cotización|cotizacion/i.test(reply);
        bubble(
          reply,
          'bot',
          wantsQuote
            ? '<a class="chat-action" href="/catalogo">Ver el catálogo</a>' +
                '<a class="chat-action" href="/contacto">Ir a contacto</a>'
            : ''
        );
      } catch {
        endpointDown = true;
        dots.remove();
        offlineAnswer();
      } finally {
        busy = false;
        send.disabled = false;
        if (conPuntero.matches) input.focus();
      }
    }

    form.addEventListener('submit', e => {
      e.preventDefault();
      ask(input.value);
    });

    suggestions?.addEventListener('click', e => {
      const chip = e.target.closest('[data-chat-suggestion]');
      if (chip) ask(chip.dataset.chatSuggestion);
    });
  })();
</script>

<style>
  /* El widget se escribe en CSS y no en clases de utilidad porque la mitad de
     sus nodos —burbujas, atajos, puntos de "escribiendo"— los crea el script en
     tiempo de ejecución, y un compilador que lee el marcado no puede ver esas
     clases. Los colores salen del tema (@theme en global.css), así que la
     paleta sigue siendo la misma que la del resto del sitio. */
  .chat {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    /* Por debajo del panel del cotizador (z-70) y del backdrop, por encima del
       resto de la página. */
    z-index: 60;
    font-size: 15px;
  }

  @media (min-width: 640px) {
    .chat {
      bottom: 1.5rem;
      right: 1.5rem;
    }
  }

  /* ---------- LANZADOR ---------- */
  /*
   * LA SOMBRA HACE EL TRABAJO QUE HACÍA UN ARO, Y LO HACE MEJOR.
   *
   * El botón flota encima de la página, así que detrás puede haber una foto
   * oscura, el azul del hero o el gris del catálogo, y tiene que separarse de
   * los tres. Se probó con un aro blanco alrededor y el resultado parecía una
   * calcomanía pegada encima. Dos sombras —una corta y cerrada que dibuja el
   * canto, otra larga y abierta que lo levanta del papel— separan igual de
   * bien y se leen como un botón que flota, que es lo que es.
   */
  .chat-launcher {
    display: inline-flex;
    align-items: center;
    /*
      `justify-content: center` ERA LO QUE FALTABA, y es el motivo por el que el
      icono se veía descolocado desde el principio.

      En el escritorio el botón mide lo que mide su contenido, así que no sobra
      espacio y esta línea no hace nada. En el móvil, en cambio, el botón es un
      cuadrado fijo de 56 px con un icono de 32: sin `justify-content`, un
      contenedor flexible reparte los 24 px sobrantes al final, así que el icono
      se pegaba al borde izquierdo y quedaba 12 px fuera del centro. A ojo
      parecía «un icono feo»; era un icono bien puesto en el sitio equivocado.
      Hay un test que lo mide, porque esto se rompe sin que nada falle.
    */
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem 0.85rem 1rem;
    border: none;
    border-radius: 999px;
    background: var(--color-brand-600);
    color: #fff;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow:
      0 3px 8px -2px rgb(0 51 92 / 0.35),
      0 14px 30px -10px rgb(0 51 92 / 0.65);
    transition:
      transform 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .chat-launcher:hover {
    background: var(--color-brand-700);
    transform: translateY(-2px);
    /* Al levantarse, la sombra se alarga: es lo que hace que el botón parezca
       que sube en vez de que se le cambió el color. */
    box-shadow:
      0 4px 10px -2px rgb(0 51 92 / 0.35),
      0 20px 38px -12px rgb(0 51 92 / 0.7);
  }

  /*
   * LLAMADA DE ATENCIÓN CADA 15 SEGUNDOS.
   *
   * El asistente es lo más útil de la página para quien llega con una duda
   * concreta, y quieto en una esquina pasa desapercibido.
   *
   * Son tres gestos a la vez, porque de uno solo no se entera nadie: el botón
   * entero se sacude —no solo el icono—, el icono además pega un salto, y por
   * detrás sale un anillo que se expande y se apaga. Duran poco más de un
   * segundo de cada quince.
   *
   * Va con un ciclo largo y un gesto corto en lugar de con un temporizador en
   * JavaScript: el navegador lo detiene solo cuando la pestaña está en segundo
   * plano y no hay nada que sincronizar. El `animation-delay` negativo NO se
   * usa aquí a propósito: el primer aviso llega a los 5 segundos, cuando ya
   * ha dado tiempo a leer la página, y no en plena carga.
   */
  .chat-llamada {
    position: relative;
    display: inline-flex;
    /* Sin esto, el `z-index: -1` del anillo lo manda detrás de la PÁGINA en
       lugar de detrás del botón, y desaparece. */
    isolation: isolate;
    animation: chat-sacudida 15s ease-in-out 5s infinite;
  }

  /* El anillo que sale de debajo del botón. Es un elemento propio y no una
     sombra: una sombra no puede escalar, y lo que se lee como "llamada" es
     justo que el círculo CREZCA. */
  .chat-pulso {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: var(--color-brand-500);
    opacity: 0;
    animation: chat-anillo 15s ease-out 5s infinite;
  }

  /*
   * EL ICONO TIENE QUE MEDIR ALGO.
   *
   * El `<svg>` del globo no trae atributos `width`/`height` —solo `viewBox`—,
   * así que dentro de un `<span>` sin tamaño se quedaba en nada: en el móvil,
   * donde la etiqueta «Asistente» no se enseña, el lanzador se veía como un
   * punto azul liso y nadie entendía que era el chat. El tamaño se pone aquí,
   * en el envoltorio y en el propio svg, y no en el marcado, para que la
   * sacudida de la llamada de atención siga teniendo un elemento propio del
   * que colgarse.
   */
  .chat-launcher-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    animation: chat-saludo 15s ease-in-out 5s infinite;
  }

  .chat-launcher-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Con el panel abierto, o con el puntero encima, ya hay atención: insistir
     sobra. */
  .chat.is-open .chat-llamada,
  .chat.is-open .chat-pulso,
  .chat.is-open .chat-launcher-icon,
  .chat-llamada:hover,
  .chat-llamada:hover .chat-pulso,
  .chat-llamada:hover .chat-launcher-icon {
    animation: none;
  }

  /* 0-8% de 15 s son 1,2 s de gesto. El resto del ciclo está quieto. */
  @keyframes chat-sacudida {
    0%,
    8%,
    100% {
      transform: none;
    }
    1% {
      transform: translate3d(0, -6px, 0) rotate(-4deg);
    }
    2.5% {
      transform: translate3d(0, 0, 0) rotate(4deg);
    }
    4% {
      transform: translate3d(0, -4px, 0) rotate(-3deg);
    }
    5.5% {
      transform: translate3d(0, 0, 0) rotate(2deg);
    }
    7% {
      transform: translate3d(0, -1px, 0) rotate(-1deg);
    }
  }

  @keyframes chat-saludo {
    0%,
    8%,
    100% {
      transform: none;
    }
    2% {
      transform: scale(1.25) rotate(-12deg);
    }
    4% {
      transform: scale(1.15) rotate(10deg);
    }
    6% {
      transform: scale(1.08) rotate(-5deg);
    }
  }

  @keyframes chat-anillo {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    8% {
      opacity: 0;
      transform: scale(1.6);
    }
    8.01%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-llamada,
    .chat-pulso,
    .chat-launcher-icon {
      animation: none;
    }
  }

  /* ---------- PANEL ---------- */
  .chat-panel {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 2rem));
    height: min(560px, calc(100vh - 8rem));
    border: 1px solid var(--color-brand-100);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: 0 24px 60px -20px rgb(0 51 92 / 0.45);
    overflow: hidden;
  }

  :global(.dark) .chat-panel {
    border-color: var(--color-neutral-700);
    background: var(--color-neutral-900);
  }

  .chat-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.9rem;
    background: var(--color-brand-700);
    color: #fff;
  }

  .chat-title {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .chat-sub {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: var(--color-brand-100);
  }

  .chat-close {
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
  }

  .chat-close svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .chat-close:hover {
    background: rgb(255 255 255 / 0.25);
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scrollbar-width: thin;
  }

  /*
    Las burbujas, los atajos y los puntos de "escribiendo" los crea el script,
    así que nacen sin el atributo de alcance de este componente y una regla con
    scope no los alcanza. Se cuelgan de `.chat-log`, que sí está en la
    plantilla, para que el alcance siga acotado al widget.
  */
  .chat-log :global(.chat-msg) {
    max-width: 88%;
    padding: 0.7rem 0.9rem;
    border-radius: 1rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .chat-log :global(.chat-msg.is-bot) {
    align-self: flex-start;
    background: var(--color-brand-50);
    color: var(--color-neutral-800);
    border-bottom-left-radius: 0.3rem;
  }

  :global(.dark) .chat-log :global(.chat-msg.is-bot) {
    background: var(--color-neutral-800);
    color: var(--color-neutral-200);
  }

  .chat-log :global(.chat-msg.is-user) {
    align-self: flex-end;
    background: var(--color-brand-600);
    color: #fff;
    border-bottom-right-radius: 0.3rem;
  }

  .chat-log :global(.chat-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .chat-log :global(.chat-action) {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-brand-300);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brand-700);
  }

  .chat-log :global(.chat-action:hover) {
