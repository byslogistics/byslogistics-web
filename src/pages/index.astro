---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import CierreSection from '@components/sections/landing/CierreSection.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import OpinionesSection from '@components/sections/testimonials/OpinionesSection.astro';
import SolutionsCarousel from '@components/ui/blocks/SolutionsCarousel.astro';
import heroImage from '@images/backgrounds/precinto-tecnologia.jpg';
import { partnersData } from '@/data_files/constants';

/**
 * Home. Es una página de entrada: resume la propuesta y enlaza a cada sección,
 * que vive en su propia página (/precintos, /productos, /usos, /nosotros,
 * /faq, /contacto).
 *
 * Las fotos de producto salen del listado de precios (ver
 * scripts/extract-xlsx-images.mjs); los fondos de sección, de las imágenes
 * de marca en src/images/backgrounds/.
 */
const soluciones = (await getCollection('soluciones')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<MainLayout heroASangre={true}>
  <HeroSection
    title=`<span class="text-brand-200">B&S</span>, Líderes en Seguridad Preventiva`
    subTitle="En B&S LOGISTICS nos especializamos en la distribución y comercialización de elementos de Seguridad preventiva. Estamos comprometidos en ofrecer productos de óptima calidad que permitan garantizar la trazabilidad y custodia de bienes y activos."
    primaryBtn="Ver Productos"
    primaryBtnURL="/productos"
    secondaryBtn="Contáctenos"
    secondaryBtnURL="/contacto"
    src={heroImage}
    nextSection="soluciones"
  />

  {
    partnersData.length > 0 && (
      <ClientsSection
        title="Empresas que confían en nosotros"
        subTitle="Suministramos a líderes de industria en múltiples sectores."
        partners={partnersData}
      />
    )
  }

  {
    /* Resumen de soluciones: cada tarjeta lleva a su propia página.
      El `id` es el destino de la señal de "sigue hacia abajo" del hero. */
  }
  <section id="soluciones" class="py-16 lg:py-24">
    <div class="mx-auto max-w-[85rem] px-10 sm:px-14 lg:px-20">
      {/* Escalonado, como el cierre de la página. Ver global.css. */}
      <div class="max-w-2xl" data-anim-cascada="izquierda">
        <h2
          class="text-3xl font-bold text-balance text-neutral-800 lg:text-5xl dark:text-neutral-100"
        >
          Nuestras Soluciones
        </h2>
        <p
          class="mt-4 max-w-prose text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400"
        >
          A continuación encontrará los productos en los que nos especializamos.
          Contamos con una completa gama a precios competitivos enfocados a
          brindar soluciones logísticas en transporte y control de activos.
        </p>
      </div>
    </div>

    {
      /*
        Carrusel y no la misma rejilla de /productos: quien baja por la portada
        ya vio esas seis tarjetas si entró al listado, y repetirlas no le dice
        nada nuevo. Aquí pasan solas, a sangre y con la foto grande, así que va
        FUERA de la caja de lectura: es una portada, no un párrafo.

        La frase de cada diapositiva es el primer punto destacado de la línea,
        no su descripción: la descripción son tres renglones, y a este tamaño
        tres renglones tapan la foto.
      */
    }
    {
      /* El carrusel entra detrás del titular. Va marcado a mano porque la
        sección ya no anima como un bloque: lleva una cascada dentro. */
    }
    <div class="mt-10 lg:mt-14" data-anim data-anim-retraso="3">
      <SolutionsCarousel
        soluciones={soluciones.map(solucion => ({
          id: solucion.id,
          title: solucion.data.title,
          subtitle: solucion.data.highlights[0] ?? solucion.data.description,
          image: solucion.data.cardImage,
          imageAlt: solucion.data.cardImageAlt,
        }))}
      />
    </div>
  </section>

  {
    /*
      Las opiniones ya no se escriben aquí: son las publicadas en la ficha de
      Google de la empresa y viven en `src/data_files/opiniones.ts`, que es una
      copia de lo que hay allí. Cada tarjeta enlaza a la ficha, así que la
      autenticidad no hay que afirmarla, se comprueba. Ver OpinionesSection.
    */
  }
  <OpinionesSection
    title="Lo que dicen nuestros clientes"
    subTitle="No son testimonios que hayamos escrito nosotros: son las reseñas publicadas en nuestra ficha de Google. Pulse cualquiera y la verá en Google, con su autor y su fecha."
  />

  {
    /*
      El cierre de la portada. El titular ya no es «Estamos aquí para
      ayudarle»: esa frase se conserva —vale, y la clienta la quería— pero
      pasada al epígrafe del bloque, que es donde una frase de cortesía cumple.
      El titular dice lo que hay que hacer a continuación, que es lo que un
      cierre de página tiene que decir.
    */
  }
  <CierreSection
    title="Cuéntenos qué necesita asegurar"
    subTitle="Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y le asesoramos con el producto ideal para su empresa."
    url="/contacto"
    btnTitle="Contáctenos ahora"
  />
</MainLayout>
