<script>
  import { traducirBusqueda } from '@utils/text';
  import type { Sustitucion } from '@utils/text';

  function initCatalog() {
    const grid = document.getElementById('catalog-grid');
    if (!grid) return;

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-catalog-item]')
    );
    const search = document.getElementById(
      'catalog-search'
    ) as HTMLInputElement | null;
    const searchClear = document.getElementById('catalog-search-clear');
    const count = document.getElementById('catalog-count');
    const status = document.getElementById('catalog-status');
    const sinonimo = document.getElementById('catalog-sinonimo');
    const empty = document.getElementById('catalog-empty');
    const reset = document.getElementById('catalog-reset');
    const activos = document.getElementById('catalog-active');
    const filtros = document.getElementById('catalog-filters');
    const toggleFiltros = document.getElementById('catalog-filters-toggle');
    const familias = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('[data-familia]')
    );

    /* Orden, vista y páginas */
    const rango = document.getElementById('catalog-rango');
    const selectOrden = document.getElementById(
      'catalog-orden'
    ) as HTMLSelectElement | null;
    const vistas = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-vista]')
    ).filter(boton => boton.tagName === 'BUTTON');
    const numeroPagina = document.getElementById('catalog-pagina');
    const numeroPaginas = document.getElementById('catalog-paginas');
    const paginacion = document.getElementById('catalog-paginacion');
    const saltos = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-pagina]')
    );

    /*
     * Referencias por página. El mismo número que usa la plantilla para pintar
     * el primer rango en el servidor (`POR_PAGINA` en el frontmatter): si los
     * dos dejan de coincidir, el «1–24 de 118» del primer pintado diría una
     * cosa y el script otra en cuanto se tocara cualquier filtro.
     */
    const POR_PAGINA = 24;

    /** Cuántos números de página se enseñan alrededor del actual antes de
     *  resumir con puntos suspensivos. */
    const VECINAS = 1;

    let pagina = 1;
    let orden = '';

    /** El orden original del catálogo: agrupado por línea y categoría. Se
     *  guarda al arrancar porque ordenar por nombre mueve los nodos, y sin
     *  esta copia no habría manera de volver. */
    const ordenOriginal = cards.slice();

    const radios = () =>
      Array.from(
        document.querySelectorAll<HTMLInputElement>('input[name="filtro"]')
      );

    const marcado = () => radios().find(radio => radio.checked) ?? null;

    /** El nombre de la línea o categoría elegida, tal como se lee en el panel. */
    function nombreDelFiltro(radio: HTMLInputElement | null) {
      if (!radio || !radio.value) return '';
      const etiqueta = radio.closest('label');
      const familia = radio.closest<HTMLElement>('[data-familia]');
      const texto = etiqueta?.textContent?.replace(/\s+/g, ' ').trim() ?? '';
      // «Toda la línea (49)» no dice cuál: se completa con el nombre de la
      // línea, que es el del desplegable donde vive esa opción.
      if (radio.value.startsWith('familia:')) {
        const linea =
          familia?.querySelector('.familia-nombre')?.textContent?.trim() ?? '';
        return linea;
      }
      return texto.replace(/\s*\(\d+\)\s*$/, '');
    }

    let ultimaBusquedaMedida = '';
    let temporizador: ReturnType<typeof setTimeout> | undefined;

    /**
     * Reordena las tarjetas.
     *
     * Se mueven los nodos de sitio en lugar de pintarlos otra vez: son ciento
     * dieciocho tarjetas con su foto ya cargada, y volver a crearlas obligaría
     * al navegador a redescargarlo todo. `appendChild` sobre un nodo que ya
     * está en el documento lo MUEVE, no lo duplica, así que basta con
     * recorrerlas en el orden nuevo.
     */
    function ordenar() {
      const lista =
        orden === 'az' || orden === 'za'
          ? ordenOriginal.slice().sort((a, b) => {
              const comparacion = (a.dataset.nombre ?? '').localeCompare(
                b.dataset.nombre ?? '',
                'es',
                { numeric: true, sensitivity: 'base' }
              );
              return orden === 'za' ? -comparacion : comparacion;
            })
          : ordenOriginal;

      for (const card of lista) grid!.appendChild(card);
      // `cards` se usa para filtrar y paginar en el orden en que se ven.
      cards.length = 0;
      cards.push(...lista);
    }

    /**
     * Los botones de página de abajo: «‹ 1 2 3 … 9 ›».
     *
     * Con cinco páginas caben todas; con veinte no, así que se enseñan la
     * primera, la última y las vecinas de la actual, y el resto se resume con
     * puntos suspensivos. Es lo que permite que la fila mida siempre lo mismo
     * en lugar de crecer con el catálogo.
     */
    function pintarPaginacion(total: number) {
      if (!paginacion) return;

      paginacion.hidden = total <= 1;
      paginacion.replaceChildren();
      if (total <= 1) return;

      const flecha = (destino: number, etiqueta: string, glifo: string) => {
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = glifo;
        boton.setAttribute('aria-label', etiqueta);
        boton.disabled = destino < 1 || destino > total;
        boton.addEventListener('click', () => irA(destino));
        return boton;
      };

      paginacion.append(flecha(pagina - 1, 'Página anterior', '‹'));

      let anterior = 0;
      for (let n = 1; n <= total; n++) {
        const cerca = Math.abs(n - pagina) <= VECINAS;
        if (n !== 1 && n !== total && !cerca) continue;

        if (anterior && n - anterior > 1) {
          const salto = document.createElement('span');
          salto.className = 'catalogo-salto';
          salto.textContent = '…';
          salto.setAttribute('aria-hidden', 'true');
          paginacion.append(salto);
        }

        const boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = String(n);
        boton.setAttribute('aria-label', `Página ${n} de ${total}`);
        if (n === pagina) boton.setAttribute('aria-current', 'page');
        boton.addEventListener('click', () => irA(n));
        paginacion.append(boton);
        anterior = n;
      }

      paginacion.append(flecha(pagina + 1, 'Página siguiente', '›'));
    }

    /**
     * Va a una página y sube a donde empiezan los resultados.
     *
     * Sin ese salto, pulsar «siguiente» desde el pie de la lista deja la
     * página nueva empezada por la mitad y parece que no ha pasado nada.
     * `scrollIntoView` sobre la barra y no sobre la rejilla, para que el
     * recuento («Mostrando 25–48 de 118») quede a la vista.
     */
    function irA(destino: number) {
      pagina = Math.max(1, destino);
      apply();
      document
        .querySelector('.catalogo-barra')
        ?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    function apply() {
      const radio = marcado();
      const valor = radio?.value ?? '';
      const [tipo, id] = valor ? valor.split(':') : ['', ''];
      /*
       * Lo escrito se traduce al vocabulario del catálogo antes de buscar:
       * quien escribe «sello» o «marchamo» está buscando un precinto. Ver
       * `traducirBusqueda` y la lista de sinonimos.ts.
       */
      const { termino: term, cambios } = traducirBusqueda(
        search?.value.trim() ?? ''
      );
      // Cada palabra por separado y todas tienen que estar: así «precinto
      // guaya» encuentra el precinto de guaya, que escrito de corrido no
      // aparece en ningún nombre.
      const palabras = term ? term.split(/\s+/) : [];

      /*
       * DOS MOTIVOS PARA NO VERSE, y no hay que confundirlos: que la
       * referencia no case con el filtro, y que case pero esté en otra página.
       * El recuento de arriba y el mensaje de «no encontramos nada» hablan del
       * PRIMERO —de cuántas hay—, mientras que el atributo `hidden` responde a
       * los dos. Por eso primero se juntan las que casan y solo después se
       * decide cuáles de ellas se pintan.
       */
      const coincidentes: HTMLElement[] = [];
      for (const card of cards) {
        const indice = card.dataset.search ?? '';
        const coincide =
          (tipo !== 'familia' || card.dataset.family === id) &&
          (tipo !== 'grupo' || card.dataset.group === id) &&
          palabras.every(palabra => indice.includes(palabra));
        if (coincide) coincidentes.push(card);
      }

      const visible = coincidentes.length;
      const totalPaginas = Math.max(1, Math.ceil(visible / POR_PAGINA));
      // Al filtrar, la página en la que se estaba puede dejar de existir.
      if (pagina > totalPaginas) pagina = totalPaginas;

      const desde = (pagina - 1) * POR_PAGINA;
      const hasta = desde + POR_PAGINA;
      const enPantalla = new Set(coincidentes.slice(desde, hasta));
      for (const card of cards) card.hidden = !enPantalla.has(card);

      if (count) count.textContent = String(visible);
      if (rango) {
        rango.textContent =
          visible === 0 ? '0' : `${desde + 1}–${Math.min(hasta, visible)}`;
      }
      if (numeroPagina) numeroPagina.textContent = String(pagina);
      if (numeroPaginas) numeroPaginas.textContent = String(totalPaginas);
      for (const boton of saltos) {
        const siguiente = boton.dataset.pagina === 'siguiente';
        boton.disabled = siguiente ? pagina >= totalPaginas : pagina <= 1;
      }
      pintarPaginacion(totalPaginas);

      if (empty) empty.hidden = visible > 0;
      if (searchClear) searchClear.hidden = !search?.value;
      pintarSinonimo(cambios);

      pintarActivos(radio, search?.value.trim() ?? '');
      escribirUrl(valor, search?.value.trim() ?? '');

      // El anuncio y la medición esperan a que quien busca deje de teclear:
      // uno para no leer una cifra por tecla, la otra para no mandar a Meta
      // «p», «pr», «pre»… como si fueran cinco búsquedas.
      clearTimeout(temporizador);
      temporizador = setTimeout(() => {
        if (status) {
          status.textContent =
            visible === 0
              ? 'Ninguna referencia coincide con esos filtros.'
              : `${visible} ${visible === 1 ? 'referencia' : 'referencias'}.`;
        }
        const termino = search?.value.trim() ?? '';
        if (termino.length >= 3 && termino !== ultimaBusquedaMedida) {
          ultimaBusquedaMedida = termino;
          window.bysTrack?.('buscar', { termino, resultados: visible });
        }
      }, 600);
    }

    /**
     * Dice con qué palabra se buscó de verdad.
     *
     * No es un detalle de cortesía: quien escribe «sello» no conoce la
     * palabra «precinto», y es la que va a necesitar para hablar con el
     * asesor comercial y para leer el resto del sitio. Enseñarla en el
     * momento en que la búsqueda funciona es donde se aprende.
     */
    function pintarSinonimo(cambios: Sustitucion[]) {
      if (!sinonimo) return;
      sinonimo.hidden = cambios.length === 0;
      if (cambios.length === 0) return;
      const [primero] = cambios;
      sinonimo.textContent = `En este catálogo, «${primero.escrito}» se llama «${primero.catalogo}».`;
    }

    /** Las fichas de lo que está filtrado, que se quitan de una en una. */
    function pintarActivos(radio: HTMLInputElement | null, termino: string) {
      if (!activos) return;
      const fichas = Array.from(
        activos.querySelectorAll<HTMLElement>('[data-quitar]')
      );
      const textos: Record<string, string> = {
        filtro: nombreDelFiltro(radio),
        busqueda: termino ? `«${termino}»` : '',
      };

      for (const ficha of fichas) {
        const texto = textos[ficha.dataset.quitar ?? ''] ?? '';
        ficha.hidden = !texto;
        const hueco = ficha.querySelector('[data-chip-texto]');
        if (hueco) hueco.textContent = texto;
        ficha.setAttribute('aria-label', `Quitar el filtro ${texto}`);
      }

      activos.hidden = fichas.every(ficha => ficha.hidden);
    }

    /**
     * Deja en la barra de direcciones lo que se está viendo, para que el
     * enlace se pueda copiar y mandar. `replaceState` y no `pushState`:
     * escribir seis letras no debe dejar seis pasos atrás en el historial.
     */
    function escribirUrl(filtro: string, termino: string) {
      const url = new URL(window.location.href);
      /*
       * Solo se escribe lo que se APARTA de lo normal: sin `p` es la primera
       * página y sin `o` es el orden del catálogo. Así el enlace que se copia
       * y se manda por WhatsApp sigue siendo `/catalogo?f=grupo:...` y no una
       * ristra de parámetros que no dicen nada.
       */
      if (filtro) url.searchParams.set('f', filtro);
      else url.searchParams.delete('f');
      if (termino) url.searchParams.set('q', termino);
      else url.searchParams.delete('q');
      if (pagina > 1) url.searchParams.set('p', String(pagina));
      else url.searchParams.delete('p');
      if (orden) url.searchParams.set('o', orden);
      else url.searchParams.delete('o');
      const destino = url.pathname + url.search;
      if (destino !== window.location.pathname + window.location.search) {
        window.history.replaceState(null, '', destino);
      }
    }

    /** Lo contrario: la URL con la que se llega manda sobre el estado inicial. */
    function leerUrl() {
      const params = new URLSearchParams(window.location.search);
      const termino = params.get('q') ?? '';
      const filtro = params.get('f') ?? '';

      const pedida = Number(params.get('p'));
      if (Number.isFinite(pedida) && pedida > 0) pagina = Math.trunc(pedida);

      const ordenPedido = params.get('o') ?? '';
      if (ordenPedido === 'az' || ordenPedido === 'za') {
        orden = ordenPedido;
        if (selectOrden) selectOrden.value = orden;
        ordenar();
      }

      if (search && termino) search.value = termino;
      if (!filtro) return;
      const radio = radios().find(item => item.value === filtro);
      if (!radio) return;
      radio.checked = true;
      // Y se abre el desplegable donde vive, o la selección no se ve.
      const familia = radio.closest<HTMLDetailsElement>('[data-familia]');
      if (familia) familia.open = true;
    }

    function limpiar() {
      if (search) search.value = '';
      const todas = radios().find(radio => radio.value === '');
      if (todas) todas.checked = true;
      // Al limpiar se cierran los desplegables: el panel vuelve al estado en
      // el que se llegó a la página, con las seis líneas a la vista.
      for (const familia of familias) familia.open = false;
      pagina = 1;
      apply();
    }

    /*
     * TOCAR UN FILTRO O EL BUSCADOR DEVUELVE A LA PRIMERA PÁGINA.
     *
     * Sin esto, quien estaba en la página 4 y escribe una palabra se queda
     * mirando la página 4 de un resultado que ahora tiene dos: la lista se ve
     * vacía y parece que la búsqueda no encontró nada.
     */
    document.addEventListener('change', event => {
      const target = event.target as HTMLElement;
      if (target.matches('input[name="filtro"]')) {
        pagina = 1;
        apply();
      }
    });

    search?.addEventListener('input', () => {
      pagina = 1;
      apply();
    });

    selectOrden?.addEventListener('change', () => {
      orden = selectOrden.value;
      ordenar();
      pagina = 1;
      apply();
    });

    /*
     * Rejilla o lista. La elección se recuerda en el navegador y no en la URL:
     * es una preferencia de quien mira, no parte de lo que se está mirando, y
     * no tiene por qué viajar en un enlace que se manda a un cliente.
     */
    const VISTA_GUARDADA = 'bys_catalogo_vista';

    function ponerVista(vista: string) {
      grid!.dataset.vista = vista;
      for (const boton of vistas) {
        boton.setAttribute(
          'aria-pressed',
          String(boton.dataset.vista === vista)
        );
      }
      try {
        localStorage.setItem(VISTA_GUARDADA, vista);
      } catch {
        // Modo privado o almacenamiento lleno: la vista funciona igual, solo
        // que no se recuerda para la próxima visita.
      }
    }

    for (const boton of vistas) {
      boton.addEventListener('click', () =>
        ponerVista(boton.dataset.vista ?? 'rejilla')
      );
    }

    try {
      const guardada = localStorage.getItem(VISTA_GUARDADA);
      if (guardada === 'lista' || guardada === 'rejilla') ponerVista(guardada);
    } catch {
      // Ver arriba.
    }

    for (const boton of saltos) {
      boton.addEventListener('click', () =>
        irA(pagina + (boton.dataset.pagina === 'siguiente' ? 1 : -1))
      );
    }

    searchClear?.addEventListener('click', () => {
      if (search) search.value = '';
      search?.focus();
      apply();
    });

    reset?.addEventListener('click', limpiar);

    for (const boton of document.querySelectorAll('[data-catalog-limpiar]')) {
      boton.addEventListener('click', () => {
        limpiar();
        search?.focus();
      });
    }

    // Quitar una ficha quita solo ese filtro, no los dos.
    activos?.addEventListener('click', event => {
      const ficha = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-quitar]'
      );
      if (!ficha) return;
      if (ficha.dataset.quitar === 'busqueda' && search) search.value = '';
      if (ficha.dataset.quitar === 'filtro') {
        const todas = radios().find(radio => radio.value === '');
        if (todas) todas.checked = true;
      }
      pagina = 1;
      apply();
      search?.focus();
    });

    // Abrir una línea no filtra por sí solo —para eso están sus radios—, pero
    // sí cierra las demás: dos acordeones abiertos a la vez devuelven la
    // columna interminable que este panel viene a quitar.
    for (const familia of familias) {
      familia.addEventListener('toggle', () => {
        if (!familia.open) return;
        for (const otra of familias) {
          if (otra !== familia) otra.open = false;
        }
      });
    }

    /*
     * El panel de filtros plegado en el móvil. Solo existe con JavaScript: el
     * botón está oculto en el HTML y se enseña aquí, para que sin scripts no
     * quede un panel que nadie puede desplegar.
     */
    if (toggleFiltros && filtros) {
      const estrecho = window.matchMedia('(max-width: 1023px)');

      const plegar = (plegado: boolean) => {
        filtros.hidden = plegado;
        toggleFiltros.setAttribute('aria-expanded', String(!plegado));
      };

      toggleFiltros.hidden = false;
      plegar(estrecho.matches);

      toggleFiltros.addEventListener('click', () => {
        plegar(toggleFiltros.getAttribute('aria-expanded') === 'true');
      });

      // Al pasar a escritorio el panel vuelve a verse, aunque se hubiera
      // plegado en el móvil: ahí abajo no hay botón que lo despliegue.
      estrecho.addEventListener('change', () => plegar(estrecho.matches));
    }

    leerUrl();
    apply();
  }

  initCatalog();
  document.addEventListener('astro:page-load', initCatalog);
</script>
