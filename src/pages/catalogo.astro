---
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import backdrop from '@images/backgrounds/precintos-estudio.jpg';
import AddToQuoteBtn from '@components/ui/buttons/AddToQuoteBtn.astro';
import ImagePlaceholder from '@components/ui/blocks/ImagePlaceholder.astro';
import { getCatalog, getFacets } from '@utils/catalog';
import { SITE } from '@data/constants';
import { eventoDeListado } from '@utils/analytics';

/**
 * Catálogo completo con filtros. Todas las referencias se imprimen en el HTML
 * y el filtrado ocurre en el navegador: son ~115 tarjetas, así que no hace
 * falta paginar ni pedir nada al servidor, y el catálogo sigue siendo
 * indexable por los buscadores.
 *
 * LOS FILTROS SON UN ACORDEÓN, NO DOS LISTAS.
 *
 * Antes había una lista de líneas y, debajo, otra con las veintitantas
 * categorías de todas ellas: para llegar a «Precintos de guaya» había que
 * recorrer con la vista una columna interminable. Ahora cada línea es un
 * desplegable que solo abre SUS categorías, así que en reposo se ven seis
 * renglones y la que interesa se abre de un clic.
 *
 * Y por eso la selección es UN solo grupo de radios con el valor prefijado
 * (`familia:` o `grupo:`): línea y categoría no son dos filtros que se
 * combinen —elegir una categoría ya implica su línea—, y tratarlos como dos
 * obligaba a sincronizarlos a mano en cada cambio.
 */
const items = await getCatalog();
const { families, groups } = getFacets(items);

const pageTitle = `Catálogo | ${SITE.title}`;
const metaDescription = `Catálogo completo de B&S Logistics: ${items.length} referencias en precintos de seguridad, etiquetas, cintas, bolsas, cajas, embalaje protector y rastreo satelital.`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/catalogo`,
    url: `${SITE.url}/catalogo`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'es-CO',
  }}
  analytics={eventoDeListado('Catálogo')}
>
  <MainSection
    title="Catálogo"
    subTitle="Filtre por línea o busque por nombre, arme su cotización y envíela por WhatsApp. Los precios se entregan por cotización según la cantidad."
    backdrop={backdrop}
  />

  <section class="mx-auto max-w-[85rem] px-10 pb-20 sm:px-14 lg:px-20">
    <div class="lg:grid lg:grid-cols-4 lg:gap-10">
      {/* Filtros */}
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-28">
          <label class="grid gap-1">
            <span
              class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
              >Buscar referencia</span
            >
            <input
              type="search"
              id="catalog-search"
              placeholder="precinto, guaya, holograma…"
              class="focus:border-brand-500 focus:ring-brand-500 rounded-lg border border-neutral-300 bg-neutral-50 px-3 py-2 text-sm text-neutral-800 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200"
            />
          </label>

          <div class="filtros mt-6">
            <p
              class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            >
              Línea de producto
            </p>

            <fieldset class="mt-3 grid gap-1">
              <legend class="sr-only">Filtrar el catálogo</legend>

              <label class="filtro-todas">
                <input
                  type="radio"
                  name="filtro"
                  value=""
                  checked
                  class="text-brand-600 focus:ring-brand-500 border-neutral-300"
                />
                <span class="text-neutral-700 dark:text-neutral-300">
                  Todas las referencias{' '}
                  <span class="text-neutral-600 dark:text-neutral-400">
                    ({items.length})
                  </span>
                </span>
              </label>

              {
                families.map(family => (
                  <details class="familia" data-familia={family.id}>
                    <summary class="familia-cabecera">
                      <span class="familia-nombre">{family.name}</span>
                      <span class="familia-cuenta">{family.count}</span>
                      <span class="filtros-chevron" aria-hidden="true" />
                    </summary>

                    <div class="familia-cuerpo">
                      <label class="filtro-opcion">
                        <input
                          type="radio"
                          name="filtro"
                          value={`familia:${family.id}`}
                          class="text-brand-600 focus:ring-brand-500 border-neutral-300"
                        />
                        <span class="text-neutral-700 dark:text-neutral-300">
                          Toda la línea{' '}
                          <span class="text-neutral-600 dark:text-neutral-400">
                            ({family.count})
                          </span>
                        </span>
                      </label>

                      {groups
                        .filter(group => group.familyId === family.id)
                        .map(group => (
                          <label class="filtro-opcion">
                            <input
                              type="radio"
                              name="filtro"
                              value={`grupo:${group.id}`}
                              class="text-brand-600 focus:ring-brand-500 border-neutral-300"
                            />
                            <span class="text-neutral-700 dark:text-neutral-300">
                              {group.name}{' '}
                              <span class="text-neutral-600 dark:text-neutral-400">
                                ({group.count})
                              </span>
                            </span>
                          </label>
                        ))}
                    </div>
                  </details>
                ))
              }
            </fieldset>

            <button
              type="button"
              id="catalog-reset"
              class="mt-5 inline-flex min-h-11 items-center rounded-lg text-sm font-medium text-neutral-600 underline underline-offset-2 outline-hidden transition hover:text-neutral-800 focus-visible:ring-3 md:min-h-0 dark:text-neutral-400 dark:hover:text-neutral-200"
            >
              Limpiar filtros
            </button>
          </div>
        </div>
      </aside>

      {/* Resultados */}
      <div class="mt-10 lg:col-span-3 lg:mt-0">
        <p
          class="text-sm text-neutral-600 dark:text-neutral-400"
          aria-live="polite"
        >
          Mostrando <span id="catalog-count">{items.length}</span> de {
            items.length
          } referencias
        </p>

        <div
          id="catalog-grid"
          class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3"
        >
          {
            items.map(item => (
              <article
                class="group flex flex-col overflow-hidden rounded-xl border border-neutral-300 bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900"
                data-catalog-item
                data-family={item.familyId}
                data-group={item.groupId}
                data-search={item.search}
              >
                {/* La foto enlaza a la ficha de la categoría, igual que el
                    epígrafe: es el mismo destino, y así el objetivo táctil no
                    es solo un renglón de texto pequeño. */}
                <a
                  href={item.url}
                  tabindex="-1"
                  aria-hidden="true"
                  class="block aspect-[4/3] overflow-hidden bg-white"
                >
                  {item.image ? (
                    <Image
                      src={item.image}
                      alt={item.imageAlt ?? item.name}
                      class="h-full w-full object-contain p-4 transition-transform duration-500 group-hover:scale-105"
                      widths={[240, 480]}
                      sizes="(min-width: 1280px) 16rem, (min-width: 640px) 40vw, 80vw"
                      loading="lazy"
                      draggable={false}
                    />
                  ) : (
                    <ImagePlaceholder />
                  )}
                </a>

                <div class="flex grow flex-col p-5">
                  <a
                    href={item.url}
                    class="text-brand-700 dark:text-brand-400 text-xs font-bold tracking-wide uppercase"
                  >
                    {item.group}
                  </a>
                  <h2 class="mt-2 font-bold text-neutral-800 dark:text-neutral-200">
                    {item.name}
                  </h2>
                  {item.description && (
                    <p class="mt-1 grow text-sm text-neutral-600 dark:text-neutral-400">
                      {item.description}
                    </p>
                  )}
                  {!item.description && <div class="grow" />}
                  <AddToQuoteBtn
                    id={item.id}
                    name={item.name}
                    group={item.group}
                  />
                </div>
              </article>
            ))
          }
        </div>

        <p
          id="catalog-empty"
          hidden
          class="mt-10 text-center text-neutral-600 dark:text-neutral-400"
        >
          No encontramos referencias con esos filtros. Prueba con otro término o
          escríbenos y te asesoramos.
        </p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* El acordeón de filtros. Va en CSS y no en clases sueltas porque son
     estados —abierto, cerrado, seleccionado— y no una lista de utilidades. */
  .familia-cabecera {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
  }

  .familia-cabecera::-webkit-details-marker {
    display: none;
  }

  .familia-cabecera {
    min-height: 2.75rem;
    padding: 0.5rem 0.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-neutral-700);
  }

  .familia-cabecera:hover {
    background: var(--color-neutral-100);
  }

  :global(.dark) .familia-cabecera {
    color: var(--color-neutral-300);
  }

  :global(.dark) .familia-cabecera:hover {
    background: var(--color-neutral-800);
  }

  .familia-nombre {
    flex: 1 1 auto;
  }

  .familia-cuenta {
    flex: none;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-neutral-200);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-neutral-600);
  }

  :global(.dark) .familia-cuenta {
    background: var(--color-neutral-800);
    color: var(--color-neutral-400);
  }

  /* Una línea con la selección dentro se marca aunque esté plegada: si no, al
     cerrarla se pierde de vista qué se está filtrando. */
  .familia:has(input:checked) .familia-cabecera {
    color: var(--color-brand-700);
  }

  :global(.dark) .familia:has(input:checked) .familia-cabecera {
    color: var(--color-brand-300);
  }

  .filtros-chevron {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    opacity: 0.6;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.25s ease;
  }

  details[open] > .familia-cabecera > .filtros-chevron {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .familia-cuerpo {
    display: grid;
    gap: 0.15rem;
    padding: 0.25rem 0 0.5rem 0.75rem;
    margin-left: 0.35rem;
    border-left: 1px solid var(--color-neutral-300);
  }

  :global(.dark) .familia-cuerpo {
    border-color: var(--color-neutral-700);
  }

  .filtro-todas,
  .filtro-opcion {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .filtro-todas {
    min-height: 2.75rem;
    font-weight: 600;
  }

  .filtro-todas:hover,
  .filtro-opcion:hover {
    background: var(--color-neutral-100);
  }

  :global(.dark) .filtro-todas:hover,
  :global(.dark) .filtro-opcion:hover {
    background: var(--color-neutral-800);
  }

  @media (prefers-reduced-motion: reduce) {
    .filtros-chevron {
      transition: none;
    }
  }
</style>

<script>
  import { normalize } from '@utils/text';

  function initCatalog() {
    const grid = document.getElementById('catalog-grid');
    if (!grid) return;

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-catalog-item]')
    );
    const search = document.getElementById(
      'catalog-search'
    ) as HTMLInputElement | null;
    const count = document.getElementById('catalog-count');
    const empty = document.getElementById('catalog-empty');
    const reset = document.getElementById('catalog-reset');
    const familias = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('[data-familia]')
    );

    function apply() {
      const marcado = document.querySelector(
        'input[name="filtro"]:checked'
      ) as HTMLInputElement | null;
      const valor = marcado?.value ?? '';
      const [tipo, id] = valor ? valor.split(':') : ['', ''];
      const term = normalize(search?.value.trim() ?? '');

      let visible = 0;
      for (const card of cards) {
        const coincide =
          (tipo !== 'familia' || card.dataset.family === id) &&
          (tipo !== 'grupo' || card.dataset.group === id) &&
          (!term || (card.dataset.search ?? '').includes(term));
        card.hidden = !coincide;
        if (coincide) visible++;
      }

      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible > 0;
    }

    document.addEventListener('change', event => {
      const target = event.target as HTMLElement;
      if (target.matches('input[name="filtro"]')) apply();
    });

    search?.addEventListener('input', apply);

    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      const todas = document.querySelector(
        'input[name="filtro"][value=""]'
      ) as HTMLInputElement | null;
      if (todas) todas.checked = true;
      // Al limpiar se cierran los desplegables: el panel vuelve al estado en
      // el que se llegó a la página, con las seis líneas a la vista.
      for (const familia of familias) familia.open = false;
      apply();
    });

    // Abrir una línea no filtra por sí solo —para eso están sus radios—, pero
    // sí cierra las demás: dos acordeones abiertos a la vez devuelven la
    // columna interminable que este panel viene a quitar.
    for (const familia of familias) {
      familia.addEventListener('toggle', () => {
        if (!familia.open) return;
        for (const otra of familias) {
          if (otra !== familia) otra.open = false;
        }
      });
    }

    apply();
  }

  initCatalog();
  document.addEventListener('astro:page-load', initCatalog);
</script>
