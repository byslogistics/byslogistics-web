---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ProductCard from '@components/ui/cards/ProductCard.astro';
import backdrop from '@images/backgrounds/logistica-claro.jpg';
import { SITE } from '@data/constants';
import { eventoDeListado } from '@utils/analytics';

const soluciones = (await getCollection('soluciones')).sort(
  (a, b) => a.data.order - b.data.order
);

const pageTitle = `Productos | ${SITE.title}`;
const metaDescription =
  'Precintos de seguridad, etiquetas y cintas, tulas y bolsas, y cajas de seguridad. Conozca la gama de elementos de seguridad preventiva de B&S Logistics.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/productos`,
    url: `${SITE.url}/productos`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'es-CO',
  }}
  analytics={eventoDeListado('Nuestras Soluciones')}
>
  <MainSection
    title="Nuestras Soluciones"
    subTitle="A continuación encontrará los productos en los que nos especializamos. Contamos con una completa gama a precios competitivos enfocados a brindar soluciones logísticas en transporte y control de activos."
    backdrop={backdrop}
    backdropTreatment="photo"
  />

  <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20 lg:pb-24">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        soluciones.map(solucion => (
          <ProductCard
            href={`/productos/${solucion.id}`}
            title={solucion.data.title}
            description={solucion.data.description}
            image={solucion.data.cardImage}
            imageAlt={solucion.data.cardImageAlt}
          />
        ))
      }
    </div>
  </section>

  <HeroSectionAlt
    title="¿No sabe cuál necesita?"
    subTitle="Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
    btnTitle="Solicitar asesoría"
  />
</MainLayout>
