---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { CONTACT, SITE } from '@data/constants';
import { getReferencias } from '@utils/catalog';
import { eventoDeListado } from '@utils/analytics';

export const getStaticPaths: GetStaticPaths = async () => {
  const soluciones = await getCollection('soluciones');
  return soluciones.map(solucion => ({
    params: { id: solucion.id },
    props: { solucion },
  }));
};

interface Props {
  solucion: CollectionEntry<'soluciones'>;
}

const { solucion } = Astro.props;
const { Content } = await render(solucion);

const pageTitle = `${solucion.data.title} | ${SITE.title}`;
const quoteHref = `mailto:${CONTACT.email}?subject=${encodeURIComponent(
  `Cotización: ${solucion.data.title}`
)}`;
/*
 * Las referencias se leen del catálogo porque de ahí sale la URL de la ficha
 * de cada una. El frontmatter sabe cómo se llaman; el catálogo sabe a dónde
 * llevan.
 */
const referencias = await getReferencias();
const referenciasPorGrupo = new Map<string, typeof referencias>();
for (const referencia of referencias) {
  if (referencia.familyId !== solucion.id) continue;
  const enGrupo = referenciasPorGrupo.get(referencia.group) ?? [];
  enGrupo.push(referencia);
  referenciasPorGrupo.set(referencia.group, enGrupo);
}

const referenceCount = solucion.data.groups.reduce(
  (total, group) => total + group.products.length,
  0
);
---

<MainLayout
  title={pageTitle}
  customDescription={solucion.data.description}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'ItemPage',
    '@id': `${SITE.url}/productos/${solucion.id}`,
    url: `${SITE.url}/productos/${solucion.id}`,
    name: pageTitle,
    description: solucion.data.description,
    inLanguage: 'es-CO',
  }}
  analytics={eventoDeListado(solucion.data.title)}
>
  <section class="mx-auto max-w-[85rem] px-10 pt-10 sm:px-14 lg:px-20">
    <Breadcrumb
      items={[
        { name: 'Inicio', url: '/' },
        { name: 'Productos', url: '/productos' },
        { name: solucion.data.title },
      ]}
    />
  </section>

  <section class="mx-auto max-w-[85rem] px-10 py-14 sm:px-14 lg:px-20 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
      <div>
        <h1
          class="text-4xl font-extrabold tracking-tight text-balance text-neutral-800 sm:text-5xl dark:text-neutral-100"
        >
          {solucion.data.title}
        </h1>
        <p
          class="mt-5 text-lg text-pretty text-neutral-600 sm:text-xl dark:text-neutral-400"
        >
          {solucion.data.description}
        </p>

        {
          solucion.data.highlights.length > 0 && (
            <ul class="mt-8 grid gap-3">
              {solucion.data.highlights.map(highlight => (
                <li class="flex items-start gap-x-3">
                  <span class="text-brand-500 dark:text-brand-400 mt-0.5">
                    <Icon name="checkCircle" />
                  </span>
                  <span class="text-neutral-700 dark:text-neutral-300">
                    {highlight}
                  </span>
                </li>
              ))}
            </ul>
          )
        }

        {
          solucion.data.catalogUrl && (
            <a
              href={solucion.data.catalogUrl}
              class="text-brand-600 dark:text-brand-400 mt-8 inline-flex items-center gap-x-2 font-medium"
            >
              {solucion.data.catalogLabel ?? 'Ver categorías'}
              <Icon name="arrowRight" />
            </a>
          )
        }

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={quoteHref}
            class="bg-brand-600 shadow-brand-600/25 hover:bg-brand-700 hover:shadow-brand-700/30 inline-flex items-center justify-center gap-x-2 rounded-full border border-transparent px-6 py-3.5 text-sm font-bold text-neutral-50 shadow-lg ring-zinc-500 outline-hidden transition duration-300 hover:-translate-y-0.5 hover:shadow-xl focus-visible:ring-3 dark:ring-zinc-200"
          >
            Solicitar cotización
          </a>
          <a
            href={CONTACT.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:border-brand-600 hover:text-brand-700 dark:hover:border-brand-400 dark:hover:text-brand-300 inline-flex items-center justify-center gap-x-2 rounded-full border-2 border-neutral-400 px-6 py-3.5 text-sm font-bold text-neutral-700 ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:border-neutral-600 dark:text-neutral-200 dark:ring-zinc-200"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </div>

      <div>
        {
          solucion.data.cardImage && (
            <Image
              class="aspect-[4/3] w-full rounded-2xl bg-white object-contain p-8"
              src={solucion.data.cardImage}
              alt={solucion.data.cardImageAlt ?? solucion.data.title}
              widths={[480, 720]}
              sizes="(min-width: 1024px) 32rem, 90vw"
              loading="eager"
            />
          )
        }
        <div
          class="prose prose-neutral dark:prose-invert prose-headings:font-bold mt-8 max-w-none"
        >
          <Content />
        </div>
      </div>
    </div>
  </section>

  {
    /* Referencias agrupadas por subtipo. Sin precios: se cotizan por cantidad. */
  }
  {
    solucion.data.groups.length > 0 && (
      <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20 lg:pb-24">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">
          Referencias disponibles
        </h2>
        <p class="mt-1 max-w-prose text-sm text-neutral-600 dark:text-neutral-400">
          {referenceCount}
          {referenceCount === 1 ? ' referencia' : ' referencias'} en total. Los
          precios se entregan por cotización según la cantidad requerida.
        </p>

        <div class="mt-8 grid gap-10">
          {solucion.data.groups.map(group => (
            <div>
              <div class="flex items-center gap-x-4">
                {/* La foto es del tipo de producto, no de cada medida: las
                    nueve bolsas courier se diferencian en centímetros. */}
                {group.image && (
                  <Image
                    class="h-20 w-20 shrink-0 rounded-xl bg-white object-contain p-1.5"
                    src={group.image}
                    alt={group.imageAlt ?? group.name}
                    widths={[160, 240]}
                    sizes="5rem"
                    loading="lazy"
                  />
                )}
                <h3 class="text-brand-700 dark:text-brand-400 text-sm font-bold tracking-wide uppercase">
                  {group.name}
                </h3>
              </div>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {(referenciasPorGrupo.get(group.name) ?? []).map(referencia => (
                  <li>
                    <a
                      href={referencia.url}
                      class="hover:border-brand-400 dark:hover:border-brand-400 flex h-full flex-col rounded-lg border border-neutral-300 bg-neutral-100 px-4 py-3 ring-zinc-500 outline-hidden transition duration-300 hover:shadow-md focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-900 dark:ring-zinc-200"
                    >
                      <span class="font-medium text-neutral-800 dark:text-neutral-200">
                        {referencia.name}
                      </span>
                      {referencia.description && (
                        <span class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                          {referencia.description}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <HeroSectionAlt
    title="Estamos Aquí Para Ayudarle, Contáctenos Ahora"
    subTitle="Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
  />
</MainLayout>
