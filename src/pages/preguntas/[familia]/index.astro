---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';
import { FAMILIAS, type Familia } from '@data/preguntas';
import {
  getPreguntasPorFamilia,
  getCategorias,
  type Pregunta,
  type Categoria,
} from '@utils/preguntas';

/**
 * Índice de una familia de preguntas.
 *
 * Es la página que puede posicionarse para las búsquedas gruesas —«precintos
 * botella», «etiquetas de seguridad»—, las que traen más visitas y para las que
 * una pregunta suelta se queda corta. Recoge todo lo que su familia responde y
 * reparte hacia cada respuesta y hacia el catálogo.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const porFamilia = await getPreguntasPorFamilia();
  return FAMILIAS.map(familia => ({
    params: { familia: familia.id },
    props: { familia, preguntas: porFamilia.get(familia.id) ?? [] },
  }));
};

interface Props {
  familia: Familia;
  preguntas: Pregunta[];
}

const { familia, preguntas } = Astro.props;

const url = `${SITE.url}/preguntas/${familia.id}`;
const pageTitle = `${familia.title} | Preguntas frecuentes | ${SITE.title}`;

const porUrl = await getCategorias();
const categorias = familia.categorias
  .map(u => porUrl.get(u))
  .filter((c): c is Categoria => c !== undefined);

/*
 * Se publica como ItemList y no como FAQPage: aquí solo están los títulos, y
 * declarar un FAQPage sin las respuestas al lado sería prometerle al buscador
 * algo que la página no enseña. Las respuestas viven en su propia página, y
 * cada una publica su FAQPage.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: familia.title,
      description: familia.description,
      inLanguage: 'es-CO',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: preguntas.length,
        itemListElement: preguntas.map((pregunta, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: pregunta.title,
          url: `${SITE.url}${pregunta.url}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Preguntas',
          item: `${SITE.url}/preguntas`,
        },
        { '@type': 'ListItem', position: 3, name: familia.title, item: url },
      ],
    },
  ],
};
---

<MainLayout
  title={pageTitle}
  customDescription={familia.description}
  customOgTitle={familia.title}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-[85rem] px-10 pt-10 sm:px-14 lg:px-20">
    <Breadcrumb
      items={[
        { name: 'Inicio', url: '/' },
        { name: 'Preguntas', url: '/preguntas' },
        { name: familia.title },
      ]}
    />
  </section>

  <section class="mx-auto max-w-[85rem] px-10 py-10 sm:px-14 lg:px-20">
    <div class="max-w-3xl">
      <h1
        class="text-3xl font-bold text-balance text-neutral-800 lg:text-5xl dark:text-neutral-100"
      >
        {familia.title}
      </h1>
      <p
        class="mt-5 text-lg leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400"
      >
        {familia.description}
      </p>
      <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
        {preguntas.length}
        {
          preguntas.length === 1
            ? 'pregunta respondida'
            : 'preguntas respondidas'
        }
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        preguntas.map(pregunta => (
          <li>
            <a
              href={pregunta.url}
              class="group hover:border-brand-400 dark:hover:border-brand-400 flex h-full flex-col rounded-2xl border border-neutral-300 bg-neutral-50 p-6 ring-zinc-500 outline-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lg focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-950 dark:ring-zinc-200"
            >
              <h2 class="font-bold text-balance text-neutral-800 dark:text-neutral-100">
                {pregunta.title}
              </h2>
              <p class="mt-3 grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                {pregunta.description}
              </p>
              <span class="text-brand-600 dark:text-brand-400 mt-4 inline-flex items-center gap-x-2 text-sm font-bold">
                Leer la respuesta
                <span class="transition-transform duration-300 group-hover:translate-x-1">
                  <Icon name="arrowRight" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    categorias.length > 0 && (
      <section class="border-t border-neutral-300 bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900">
        <div class="mx-auto max-w-[85rem] px-10 py-16 sm:px-14 lg:px-20">
          <h2 class="text-2xl font-bold text-neutral-800 lg:text-3xl dark:text-neutral-100">
            Productos de esta línea
          </h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {categorias.map(categoria => (
              <a
                href={categoria.url}
                class="group hover:border-brand-400 dark:hover:border-brand-400 flex flex-col overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-50 ring-zinc-500 outline-hidden transition duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:ring-3 dark:border-neutral-700 dark:bg-neutral-950 dark:ring-zinc-200"
              >
                {categoria.imagen && (
                  <div class="flex aspect-[5/3] items-center justify-center bg-white">
                    <Image
                      src={categoria.imagen}
                      alt={categoria.imagenAlt ?? categoria.nombre}
                      class="h-full w-full object-contain p-5 transition-transform duration-500 group-hover:scale-105"
                      widths={[320, 480]}
                      sizes="(min-width: 1024px) 24rem, 90vw"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex grow flex-col p-5">
                  <h3 class="font-bold text-neutral-800 dark:text-neutral-100">
                    {categoria.nombre}
                  </h3>
                  <p class="mt-2 grow text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                    {categoria.descripcion}
                  </p>
                  <span class="text-brand-600 dark:text-brand-400 mt-4 inline-flex items-center gap-x-2 text-sm font-bold">
                    Ver referencias
                    <span class="transition-transform duration-300 group-hover:translate-x-1">
                      <Icon name="arrowRight" />
                    </span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</MainLayout>
