---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import ImagePlaceholder from '@components/ui/blocks/ImagePlaceholder.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import AddToQuoteBtn from '@components/ui/buttons/AddToQuoteBtn.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { getReferencias } from '@utils/catalog';
import { SITE } from '@data/constants';
import { eventoDeListado } from '@utils/analytics';

export const getStaticPaths: GetStaticPaths = async () => {
  const precintos = await getCollection('precintos');
  return precintos.map(categoria => ({
    params: { id: categoria.id },
    props: { categoria },
  }));
};

interface Props {
  categoria: CollectionEntry<'precintos'>;
}

const { categoria } = Astro.props;
const { Content } = await render(categoria);

const pageTitle = `${categoria.data.title} | ${SITE.title}`;

/*
 * Las referencias se leen del catálogo y no del frontmatter de la categoría
 * porque de ahí sale la URL de cada ficha y el identificador que usa el
 * cotizador. Las mismas dos cosas que necesita la tarjeta.
 */
const referencias = (await getReferencias()).filter(
  referencia => referencia.groupId === categoria.id
);
---

<MainLayout
  title={pageTitle}
  customDescription={categoria.data.description}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/precintos/${categoria.id}`,
    url: `${SITE.url}/precintos/${categoria.id}`,
    name: pageTitle,
    description: categoria.data.description,
    inLanguage: 'es-CO',
  }}
  analytics={eventoDeListado(categoria.data.title, categoria.data.title)}
>
  <section class="mx-auto max-w-[85rem] px-10 pt-10 sm:px-14 lg:px-20">
    <Breadcrumb
      items={[
        { name: 'Inicio', url: '/' },
        { name: 'Precintos', url: '/precintos' },
        { name: categoria.data.title },
      ]}
    />
  </section>

  <section class="mx-auto max-w-[85rem] px-10 py-14 sm:px-14 lg:px-20 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="lg:col-span-7">
        <h1
          class="text-4xl font-extrabold tracking-tight text-balance text-neutral-800 sm:text-5xl dark:text-neutral-100"
        >
          {categoria.data.title}
        </h1>
        <p
          class="mt-5 max-w-prose text-lg text-pretty text-neutral-600 sm:text-xl dark:text-neutral-400"
        >
          {categoria.data.description}
        </p>
        <div
          class="prose prose-neutral dark:prose-invert prose-headings:font-bold mt-8 max-w-prose"
        >
          <Content />
        </div>
      </div>

      {
        categoria.data.cardImage && (
          <div class="lg:col-span-5">
            <Image
              class="aspect-[4/3] w-full rounded-2xl bg-white object-contain p-8"
              src={categoria.data.cardImage}
              alt={categoria.data.cardImageAlt ?? categoria.data.title}
              widths={[480, 720]}
              sizes="(min-width: 1024px) 32rem, 90vw"
              loading="eager"
            />
          </div>
        )
      }
    </div>
  </section>

  {
    referencias.length > 0 && (
      <section class="mx-auto max-w-[85rem] px-10 pb-16 sm:px-14 lg:px-20 lg:pb-24">
        <h2 class="text-3xl font-bold text-neutral-800 dark:text-neutral-100">
          Referencias
        </h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          Mostrando {referencias.length}
          {referencias.length === 1 ? ' resultado' : ' resultados'}. Los precios
          se entregan por cotización según la cantidad requerida.
        </p>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {referencias.map(referencia => (
            <div class="group hover:border-brand-400 dark:hover:border-brand-400 flex flex-col overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 transition duration-300 hover:shadow-lg dark:border-neutral-700 dark:bg-neutral-900">
              {/* La foto y el título llevan a la ficha; el botón de cotizar
                  se queda como acción aparte dentro de la misma tarjeta. Un
                  botón dentro de un enlace no es marcado válido, y de paso
                  quien solo quiere cotizar no tiene que entrar a la ficha. */}
              <a
                href={referencia.url}
                tabindex="-1"
                aria-hidden="true"
                class="relative aspect-[5/3] overflow-hidden bg-white"
              >
                {referencia.image ? (
                  <Image
                    class="absolute inset-0 h-full w-full object-contain p-6 transition-transform duration-500 group-hover:scale-105"
                    src={referencia.image}
                    alt={referencia.imageAlt ?? referencia.name}
                    widths={[320, 480]}
                    sizes="(min-width: 1024px) 24rem, (min-width: 640px) 45vw, 90vw"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <ImagePlaceholder />
                  </div>
                )}
              </a>
              <div class="flex grow flex-col p-6 sm:p-7">
                {referencia.code && (
                  <p class="text-xs text-neutral-600 dark:text-neutral-400">
                    Ref. {referencia.code}
                  </p>
                )}
                <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">
                  <a
                    href={referencia.url}
                    class="hover:text-brand-700 dark:hover:text-brand-300 rounded-lg ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:ring-zinc-200"
                  >
                    {referencia.name}
                  </a>
                </h3>
                {referencia.description && (
                  <p class="mt-2 grow text-sm text-neutral-600 dark:text-neutral-400">
                    {referencia.description}
                  </p>
                )}
                {!referencia.description && <div class="grow" />}
                <a
                  href={referencia.url}
                  class="text-brand-600 dark:text-brand-400 mt-5 inline-flex items-center gap-x-2 self-start text-sm font-bold"
                >
                  Ver producto
                  <span class="transition-transform duration-300 group-hover:translate-x-1">
                    <Icon name="arrowRight" />
                  </span>
                </a>
                <AddToQuoteBtn
                  id={referencia.id}
                  name={referencia.name}
                  group={referencia.group}
                />
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <HeroSectionAlt
    title="Estamos Aquí Para Ayudarle, Contáctenos Ahora"
    subTitle="Tenemos una gran variedad de elementos de seguridad. Descríbanos su necesidad y podremos asesorarle con respecto al producto ideal para su empresa."
    url="/contacto"
  />
</MainLayout>
